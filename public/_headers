# NOT USED ON VERCEL. This is the Netlify / Cloudflare Pages format; Vercel reads
# vercel.json instead, which carries the same rules. Kept so the config survives a
# move to either of those hosts — edit both, or delete this if that is not a plan.
# Performance and Security Headers

/*
  # Security
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

  # HTML is the default here: pages live at extensionless paths (/contact/, /blog/…),
  # so a long immutable cache on /* would pin stale pages for a year and stop
  # content updates from ever reaching crawlers or returning visitors.
  Cache-Control: public, max-age=0, must-revalidate

# Fingerprinted build output — safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Images and logos are not fingerprinted, so cache for a day and revalidate.
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/logos/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Pagefind search index — rebuilt with every deploy.
/pagefind/*
  Cache-Control: public, max-age=3600, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/sitemap-index.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600

/api/*
  Cache-Control: no-store
