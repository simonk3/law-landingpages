{
  "name": "lex-duo-website",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "optimize-images": "node scripts/optimize-images.js",
    "seo:check": "astro check",
    "seo:build": "npm run build && npm run seo:analyze",
    "seo:analyze": "npx lighthouse --output=json --output-path=./lighthouse-report.json --chrome-flags='--headless' http://localhost:4321",
    "seo:test": "npm run build && npm run preview & sleep 5 && npm run seo:analyze && pkill -f 'astro preview'"
  },
  "dependencies": {
    "@astrojs/partytown": "^2.1.4",
    "@microsoft/clarity": "^1.0.0",
    "@prismicio/client": "^7.17.3",
    "@prismicio/helpers": "^2.3.9",
    "@tailwindcss/vite": "^4.1.5",
    "astro": "^5.8.0",
    "sharp": "^0.34.2",
    "tailwindcss": "^4.1.5"
  },
  "description": "Lex Duo - професійна адвокатська компанія в Києві. Спеціалізуємося на цивільних, кримінальних та господарських справах.",
  "main": "index.js",
  "keywords": [
    "Lex Duo",
    "адвокатська компанія",
    "юридична допомога",
    "судовий захист",
    "адвокат Київ",
    "цивільні справи",
    "кримінальні справи",
    "господарські спори"
  ],
  "author": "Lex Duo",
  "license": "ISC",
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/sitemap": "^3.5.0",
    "lighthouse": "^12.8.1"
  }
}
