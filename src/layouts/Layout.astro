---
import Footer from "../components/elements/Footer.astro";
import Navbar from "../components/elements/Navbar.astro";
import TelegramPopup from '../components/TelegramPopup.astro';
import TelegramFab from '../components/TelegramFab.astro';
import GTMConfig from '../components/analytics/GTMConfig.astro';
import HotjarConfig from '../components/analytics/HotjarConfig.astro';

export interface Props {
  title: string;
  description?: string;
}

const { 
  title,
  description = "Lex Duo - професійна адвокатська компанія в Києві. Спеціалізуємося на цивільних, кримінальних та господарських справах. Надаємо комплексну юридичну допомогу, судовий захист та правовий супровід."
} = Astro.props;

// Get GTM ID from environment variable or use default
const gtmId = import.meta.env.PUBLIC_GTM_ID || 'GTM-WL4BWZLZ';
const isDevelopment = import.meta.env.DEV;
---

<!DOCTYPE html>
<html lang="uk">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <!-- Google Tag Manager -->
    <GTMConfig gtmId={gtmId} enableDebug={isDevelopment} />
    <!-- End Google Tag Manager -->
    
    <!-- Hotjar Analytics -->
    <HotjarConfig />
    <!-- End Hotjar Analytics -->
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content="Lex Duo" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <link rel="canonical" href={Astro.url.href} />
    <meta name="theme-color" content="#111827" />
    
    <!-- Ukrainian Language Meta Tags -->
    <meta name="language" content="uk" />
    <meta name="geo.region" content="UA-30" />
    <meta name="geo.placename" content="Київ" />
    <meta name="geo.position" content="50.4501;30.5234" />
    <meta name="ICBM" content="50.4501, 30.5234" />
    
    <!-- Keywords Meta Tag -->
    <meta name="keywords" content="адвокат Київ, адвокати Кушніренко, правовий захист, юридична допомога, судовий захист, кримінальний адвокат, військовий адвокат, цивільні справи, господарські спори, сімейне право, адвокатська компанія Київ, Lex Duo, мобілізація адвокат, ДТП адвокат, правова консультація" />


    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={`Lex Duo - ${title}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/hero-1200.webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="uk_UA" />
    <meta property="og:site_name" content="Lex Duo" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta property="og:locale:alternate" content="ru_RU" />
    
    <!-- Additional Open Graph Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:image:alt" content="Lex Duo - Адвокатська компанія в Києві" />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:secure_url" content="/images/hero-1200.webp" />
    
    <!-- Business Information -->
    <meta property="business:contact_data:street_address" content="Київ, Україна" />
    <meta property="business:contact_data:locality" content="Київ" />
    <meta property="business:contact_data:region" content="Київська область" />
    <meta property="business:contact_data:postal_code" content="01001" />
    <meta property="business:contact_data:country_name" content="Україна" />
    <meta property="business:contact_data:phone_number" content="+380-XX-XXX-XXXX" />
    <meta property="business:contact_data:website" content={Astro.url.origin} />
    <meta property="business:contact_data:email" content="info@lexduo.com.ua" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url.href} />
    <meta property="twitter:title" content={`Lex Duo - ${title}`} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="/images/hero-1200.webp" />
    <meta property="twitter:image:alt" content="Lex Duo - Адвокатська компанія в Києві" />
    <meta property="twitter:site" content="@lexduo" />
    <meta property="twitter:creator" content="@kushnirenko" />

    <title>Lex Duo - {title}</title>
    <!-- Google Fonts with Cyrillic support -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Raleway:wght@400;500;600;700&display=swap&subset=latin,cyrillic" rel="stylesheet">

    <!-- Structured Data -->
