        }
      ],
      serviceArea: {
        '@type': 'Country',
        name: 'Україна'
      },
      availableLanguage: ['uk', 'en', 'ru'],
      paymentAccepted: ['Cash', 'Credit Card', 'Bank Transfer'],
      currenciesAccepted: 'UAH, USD, EUR',
      openingHours: 'Mo-Fr 09:00-18:00',
      contactPoint: {
        '@type': 'ContactPoint',
        telephone: '+380-XX-XXX-XXXX',
        contactType: 'customer service',
        availableLanguage: ['uk', 'en', 'ru'],
        serviceArea: 'UA'
      },
      review: [
        {
          '@type': 'Review',
          author: {
            '@type': 'Person',
            name: 'Анонімний клієнт'
          },
