            }
          },
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Цифрове право',
              description: 'Кібербезпека, захист персональних даних, GDPR, блокчейн'
            }
          },
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Екологічне право',
              description: 'Екологічні спори, захист навколишнього середовища'
            }
          },
          {
            '@type': 'Offer',
            itemOffered: {
