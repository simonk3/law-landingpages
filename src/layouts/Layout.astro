---
import Footer from "../components/elements/Footer.astro";
import Navbar from "../components/elements/Navbar.astro";
import TelegramPopup from '../components/TelegramPopup.astro';
import TelegramFab from '../components/TelegramFab.astro';

export interface Props {
  title: string;
  description?: string;
}

const { 
  title,
  description = "Lex Duo - професійна адвокатська компанія в Києві. Спеціалізуємося на цивільних, кримінальних та господарських справах. Надаємо комплексну юридичну допомогу, судовий захист та правовий супровід."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="uk">
  <head>
    <!-- Google tag (gtag.js) -->
    <!-- eslint-disable -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-CCLV354VP7"></script>
    <script>
      // eslint-disable-next-line
      window.dataLayer = window.dataLayer || [];
      // eslint-disable-next-line
      function gtag(){dataLayer.push(arguments);} 
      // eslint-disable-next-line
      gtag('js', new Date());
      // eslint-disable-next-line
      gtag('config', 'G-CCLV354VP7');
    </script>
    <!-- Microsoft Clarity -->
    <script type="text/javascript">
      (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "sgefw73eyk");
    </script>
    <!-- eslint-enable -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="keywords" content="Lex Duo, адвокат Київ, адвокатська компанія, юридична допомога, судовий захист, цивільні справи, кримінальні справи, господарські спори, військовий адвокат, юридичні послуги, правовий супровід, адвокатська фірма Київ, адвокат захист, військове право, мобілізація, військовослужбовці, кримінальне право, цивільне право, господарське право, адвокат по кримінальних справах, адвокат по цивільних справах, адвокат по господарських справах, юридична консультація, правова допомога, захист прав, судові спори, адвокатська практика" />
    <meta name="author" content="Lex Duo" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <link rel="canonical" href={Astro.url.href} />
    <meta name="theme-color" content="#111827" />
    
    <!-- Ukrainian Language Meta Tags -->
    <meta name="language" content="uk" />
    <meta name="geo.region" content="UA-30" />
    <meta name="geo.placename" content="Київ" />
    <meta name="geo.position" content="50.4501;30.5234" />
    <meta name="ICBM" content="50.4501, 30.5234" />
    
    <!-- Additional Ukrainian Keywords -->
    <meta name="keywords" content="адвокат Київ, адвокатська компанія, юридична допомога, судовий захист, цивільні справи, кримінальні справи, господарські спори, військовий адвокат, юридичні послуги, правовий супровід, адвокатська фірма Київ, адвокат захист, військове право, мобілізація, військовослужбовці, кримінальне право, цивільне право, господарське право, адвокат по кримінальних справах, адвокат по цивільних справах, адвокат по господарських справах, юридична консультація, правова допомога, захист прав, судові спори, адвокатська практика, Lex Duo, Кушніренко, адвокати Кушніренко" />

    <!-- Performance: preconnect for Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={`Lex Duo - ${title}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/hero-1200.webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="uk_UA" />
    <meta property="og:site_name" content="Lex Duo" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url.href} />
    <meta property="twitter:title" content={`Lex Duo - ${title}`} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="/images/hero-1200.webp" />

    <title>Lex Duo - {title}</title>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Raleway:wght@300;400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Raleway:wght@300;400;500;600;700&display=swap" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Raleway:wght@300;400;500;600;700&display=swap" />
    </noscript>

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'LegalService',
      name: 'Lex Duo',
      alternateName: ['Адвокати Кушніренко', 'Кушніренко', 'Kushnirenko', 'Advokaty Kushnirenko', 'Адвокатська компанія Lex Duo'],
      url: Astro.url.origin,
      description: description,
      image: `${Astro.url.origin}/images/hero-1200.webp`,
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Київ',
        addressCountry: 'UA',
        addressRegion: 'Київ'
      },
      areaServed: {
        '@type': 'Country',
        name: 'Україна'
      },
      serviceType: 'Юридичні послуги',
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Юридичні послуги Lex Duo',
        itemListElement: [
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Кримінальне право',
              description: 'Захист у кримінальних справах'
            }
          },
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Цивільне право',
              description: 'Представництво в цивільних справах'
            }
          },
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Військове право',
              description: 'Юридична допомога військовослужбовцям'
            }
          },
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Господарське право',
              description: 'Представництво в господарських спорах'
            }
          }
        ]
      },
      sameAs: [
        'https://t.me/kushnirenko33'
      ]
    }, null, 2)}>
    </script>
  </head>
  <body class="overflow-hidden overflow-y-auto bg-body">
    <Navbar />
    <slot />
    <Footer />
    <TelegramPopup tgLink="https://t.me/kushnirenko33" delayMs="7000" />
    <TelegramFab tgLink="https://t.me/kushnirenko33" />
  </body>
  <script>
    const switchTheme = document.querySelector(
      "[data-switch-theme]"
    ) as HTMLButtonElement;

    if (
      localStorage.getItem("appTheme") === "dark" ||
      (!("appTheme" in localStorage) &&
        window.matchMedia("(prefers-color-scheme: dark)").matches)
    ) {
      document.documentElement.classList.add("dark");
    } else {
      document.documentElement.classList.remove("dark");
    }
    if (switchTheme) {
      switchTheme.addEventListener("click", (e) => {
        e.preventDefault();
        const doc = document.documentElement;
        if (doc) {
          if (localStorage.getItem("appTheme")) {
            if (localStorage.getItem("appTheme") === "light") {
              doc.classList.add("dark");
              localStorage.setItem("appTheme", "dark");
            } else {
              document.documentElement.classList.remove("dark");
              localStorage.setItem("appTheme", "light");
            }
          } else {
            if (doc.classList.contains("dark")) {
              doc.classList.remove("dark");
              localStorage.setItem("appTheme", "light");
            } else {
              doc.classList.add("dark");
              localStorage.setItem("appTheme", "dark");
            }
          }
        }
      });
    }
  </script>
  <script>
    const toggleMenu = document.querySelector(
      "[data-toggle-nav]"
    ) as HTMLButtonElement;
    const navbar = document.querySelector("[data-navbar]") as HTMLDivElement;
    const overlayNav = document.querySelector(
      "[data-nav-overlay]"
    ) as HTMLDivElement;
    if (toggleMenu) {
      toggleMenu.addEventListener("click", e => {
        e.preventDefault();
        if (toggleMenu.getAttribute("data-open-nav") === "false") {
          toggleMenu.setAttribute("data-open-nav", "true");
          overlayNav.setAttribute("data-is-visible", "true");
          document.body.classList.add("!overflow-y-hidden");
	  navbar.style.height = `${navbar.scrollHeight}px`

        }else{
			toggleMenu.setAttribute("data-open-nav", "false");
        	overlayNav.setAttribute("data-is-visible", "false");
        	document.body.classList.remove("!overflow-y-hidden");
	  		navbar.style.height = "0px"
		}
		
        
      });

      navbar.addEventListener("click", () => {
        toggleMenu.setAttribute("data-open-nav", "false");
        overlayNav.setAttribute("data-is-visible", "false");
        document.body.classList.remove("!overflow-y-hidden");
	  		navbar.style.height = "0px"
      });

      overlayNav.addEventListener("click", () => {
        toggleMenu.setAttribute("data-open-nav", "false");
        	overlayNav.setAttribute("data-is-visible", "false");
        	document.body.classList.remove("!overflow-y-hidden");
	  		navbar.style.height = "0px"
      });
    }
  </script>
</html>
<style is:global>
  :root {
    --color-bg: 255 255 255;
    --color-border: 255 255 255;
    --color-box: 255 255 255;
    --box-border: 229 231 235;
    --box-sd: 226 232 240 / 0.5;
	--heading-1:  23 37 84;
	--heading-2: 31 41 55;
	--heading-3: 55 65 81;
  }

  .dark {
    --color-bg: 3 7 18;
    --color-box: 17 24 39;
    --box-border: 243 244 246/0.1;
    --box-sd: transparent;

	
	--heading-1:  255 255 255;
	--heading-2:  243 244 246;
	--heading-3:  209 213 219;
  }

  html{
    scroll-behavior: smooth;
  }
  body {
    font-family: "Raleway", sans-serif;
  }

  [data-toggle-nav][data-open-nav="true"] #line1 {
    transform: translateY(0.375rem) rotate(40deg);
  }
  [data-toggle-nav][data-open-nav="true"] #line2 {
    transform: scaleX(0);
    opacity: 0;
  }
  [data-toggle-nav][data-open-nav="true"] #line3 {
    transform: translateY(-0.375rem) rotate(-40deg);
  }

  
  [data-nav-overlay][data-is-visible="true"] {
    visibility: visible;
    display: flex;
  }
</style>
