---
import "../styles/global.css"
import Layout from "../layouts/Layout.astro";
import Container from "../components/shared/Container.astro";
import Paragraph from "../components/shared/Paragraph.astro";
---

<Layout title="Дякуємо за звернення">
    <main class="flex flex-col overflow-hidden">
        <section class="relative pt-32 lg:pt-36">
            <Container>
                <div class="w-full relative py-8 md:py-10 px-6 md:px-8 rounded-2xl bg-gradient-to-tr from-gray-100 to-gray-200 dark:from-gray-900 dark:to-transparent">
                    <!-- Background decorative elements -->
                    <div class="absolute right-0 top-0 h-full w-full flex justify-end">
                        <div class="w-28 h-28 overflow-auto flex rounded-xl relative blur-2xl">
                            <span class="absolute w-16 h-16 -top-1 -right-1 bg-green-500 rounded-md rotate-45"></span>
                            <span class="absolute w-16 h-16 -bottom-1 -right-1 bg-[#FCDC58] rounded-md rotate-45"></span>
                            <span class="absolute w-16 h-16 -bottom-1 -left-1 bg-primary rounded-md rotate-45"></span>
                        </div>
                    </div>

                    <div class="absolute left-0 bottom-0 h-full w-full flex items-end">
                        <div class="w-28 h-28 overflow-auto flex rounded-xl relative blur-2xl">
                            <span class="absolute w-16 h-16 -top-1 -right-1 bg-green-500 rounded-md rotate-45"></span>
                            <span class="absolute w-16 h-16 -bottom-1 -right-1 bg-[#FCDC58] rounded-md rotate-45"></span>
                            <span class="absolute w-16 h-16 -bottom-1 -left-1 bg-primary rounded-md rotate-45"></span>
                        </div>
                    </div>

                    <!-- Content -->
                    <div class="relative text-center max-w-3xl mx-auto space-y-4">
                        <h1 class="text-3xl/tight sm:text-4xl/tight md:text-5xl/tight font-bold text-heading-1">
                            Дякуємо за ваше звернення!
                        </h1>
                        <Paragraph>
                            Ми отримали вашу контактну інформацію та зв'яжемося з вами найближчим часом.
                        </Paragraph>
                        <div class="pt-8">
                            <a href="/" class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-primary text-white hover:bg-primary/90 transition-colors">
                                Повернутися на головну
                            </a>
                        </div>
                    </div>
                </div>
            </Container>
        </section>
    </main>
    <script is:inline>
      if (typeof window !== 'undefined' && window.gtag) {
        window.gtag('event', 'contact_form_submitted');
      }
    </script>
</Layout> 