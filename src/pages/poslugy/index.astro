---
import "../../styles/global.css"
import Layout from '../../layouts/Layout.astro';
import Container from '../../components/shared/Container.astro';
import Paragraph from '../../components/shared/Paragraph.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import { practiceAreas } from '../../data/practice-areas.ts';
---

<Layout
  title="Послуги адвоката в Києві | Lex Duo"
  description="Юридичні послуги адвокатів Lex Duo в Києві: кримінальні справи, військове право, сімейне право, ДТП, господарські та адміністративні спори."
>
  <meta name="keywords" content="послуги адвоката Київ, юридичні послуги, адвокат Кушніренко, кримінальний адвокат, військовий адвокат, сімейний адвокат, адвокат ДТП, господарський адвокат" />

  <main class="flex flex-col gap-y-16 overflow-hidden pt-32 lg:pt-36 pb-20">
    <Container className="space-y-6">
      <Breadcrumbs items={[
        { name: 'Головна', url: '/' },
        { name: 'Послуги', url: '/poslugy' },
      ]} />
      <div class="max-w-3xl space-y-4">
        <h1 class="text-3xl/tight sm:text-4xl/tight md:text-5xl/tight font-bold text-heading-1">
          Послуги адвоката в Києві
        </h1>
        <Paragraph>
          Lex Duo надає комплексну юридичну допомогу приватним особам і бізнесу в Києві та по всій Україні. Оберіть напрямок, щоб дізнатися більше про те, як ми можемо допомогти саме у вашій ситуації.
        </Paragraph>
      </div>
    </Container>

    <Container>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        {practiceAreas.map((area) => (
          <a
            href={`/poslugy/${area.slug}`}
            class="p-6 lg:p-8 rounded-3xl border border-box-border bg-box-bg shadow-lg shadow-box-shadow relative overflow-hidden hover:border-primary transition-colors"
          >
            <div class="rounded-xl bg-gray-300 dark:bg-gray-950 p-3 text-heading-1 w-max relative">
              <Fragment set:html={area.icon} />
            </div>
            <div class="mt-6 space-y-3 relative">
              <h2 class="text-lg md:text-xl font-semibold text-heading-2">{area.navTitle}</h2>
              <Paragraph>{area.intro.slice(0, 140)}…</Paragraph>
              <span class="inline-flex items-center gap-1 text-primary font-medium">
                Детальніше
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
                </svg>
              </span>
            </div>
            <span class="absolute w-32 aspect-square -bottom-16 -right-16 bg-primary/10 rounded-full"></span>
          </a>
        ))}
      </div>
    </Container>
  </main>
</Layout>
