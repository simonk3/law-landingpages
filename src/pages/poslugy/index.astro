---
import "../../styles/global.css"
import Layout from '../../layouts/Layout.astro';
import Container from '../../components/shared/Container.astro';
import Paragraph from '../../components/shared/Paragraph.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import CTA from '../../components/sections/CTA.astro';
import { practiceAreas } from '../../data/practice-areas.ts';
---

<Layout
  title="Послуги адвоката в Києві | Lex Duo"
  description="Юридичні послуги адвокатів Lex Duo в Києві: кримінальні справи, військове право, сімейне право, ДТП, господарські та адміністративні спори."
>
  <main id="main-content" class="flex flex-col gap-y-16 overflow-hidden pt-32 lg:pt-36">
    <Container className="space-y-10">
      <Breadcrumbs items={[
        { name: 'Головна', url: '/' },
        { name: 'Послуги', url: '/poslugy/' },
      ]} />

      {/* Heading on the left, the pitch in two columns beside it: one column says how
          we work, the other what we cover, so the grid below needs no extra copy. */}
      <div class="grid lg:grid-cols-3 gap-6 lg:gap-12 border-t border-box-border pt-10">
        <h1 class="text-3xl/tight sm:text-4xl/tight font-bold font-display uppercase text-heading-1">
          Галузі практики
        </h1>
        <Paragraph>
          Lex Duo — адвокатське об'єднання «Кушніренко і партнери» в Києві. Кожну справу особисто веде один із двох партнерів: ви знаєте, хто ваш адвокат, і маєте з ним прямий зв'язок. Пояснюємо зрозуміло, називаємо ризики чесно і пропонуємо чіткий план дій.
        </Paragraph>
        <Paragraph>
          Захищаємо приватних осіб і бізнес у кримінальних провадженнях, справах військовослужбовців і мобілізованих, сімейних спорах, справах про ДТП, господарських, цивільних та адміністративних спорах — у Києві та по всій Україні.
        </Paragraph>
      </div>
    </Container>

    <Container>
      <ul class="grid sm:grid-cols-2 lg:grid-cols-3 border-l border-t border-box-border">
        {practiceAreas.map((area) => (
          <li class="border-r border-b border-box-border">
            <a
              href={`/poslugy/${area.slug}/`}
              class="group flex h-full min-h-36 items-center justify-between gap-6 p-6 lg:p-8 text-heading-1 hover:bg-primary hover:text-white focus-visible:bg-primary focus-visible:text-white transition-colors"
            >
              <span class="space-y-2">
                <span class="block text-base lg:text-lg font-bold font-display uppercase leading-snug">
                  {area.navTitle}
                </span>
                <span class="block text-sm text-heading-3 group-hover:text-white/80 group-focus-visible:text-white/80 transition-colors">
                  {area.serviceGroups.flatMap((g) => g.services).length} напрямів роботи
                </span>
              </span>
              <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 shrink-0 group-hover:translate-x-1 transition-transform">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </Container>

    <CTA />
  </main>
</Layout>
