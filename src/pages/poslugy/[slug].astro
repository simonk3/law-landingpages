---
import "../../styles/global.css"
import Layout from '../../layouts/Layout.astro';
import Container from '../../components/shared/Container.astro';
import Paragraph from '../../components/shared/Paragraph.astro';
import ContactTelegram from '../../components/shared/ContactTelegram.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import FAQSchema from '../../components/seo/FAQSchema.astro';
import LegalServiceSchema from '../../components/seo/LegalServiceSchema.astro';
import LeadForm from '../../components/shared/LeadForm.astro';
import { practiceAreas } from '../../data/practice-areas.ts';
import { contact } from '../../config/contact';
import { getAdvocate } from '../../data/advocates';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return practiceAreas.map((area) => ({
    params: { slug: area.slug },
    props: { area },
  }));
}

const { area } = Astro.props as { area: (typeof practiceAreas)[number] };
const related = practiceAreas.filter((a) => a.slug !== area.slug).slice(0, 3);

const keyContact = getAdvocate(area.keyContact);
if (!keyContact) {
  throw new Error(`practice-areas.ts: ${area.slug} names key contact "${area.keyContact}", which is not in advocates.ts`);
}

// A slug that no longer exists would render a dead link, so it fails the build instead.
const posts = await getCollection('blog', ({ data }) => !data.draft);
const relatedPosts = (area.relatedPosts ?? []).map((slug) => {
  const post = posts.find((p) => p.id === slug);
  if (!post) {
    throw new Error(`practice-areas.ts: ${area.slug} lists blog post "${slug}", which does not exist`);
  }
  return post;
});
---

<Layout title={area.metaTitle} description={area.metaDescription}>
  <FAQSchema faqs={area.faqs} />
  <LegalServiceSchema
    serviceName={`${area.navTitle} — Lex Duo`}
    description={area.metaDescription}
    serviceType={area.navTitle}
    path={`/poslugy/${area.slug}/`}
    serviceGroups={area.serviceGroups}
  />

  <main id="main-content" class="flex flex-col gap-y-16 md:gap-y-20 overflow-hidden pt-32 lg:pt-36 pb-20">
    <Container className="space-y-6">
      <Breadcrumbs items={[
        { name: 'Головна', url: '/' },
        { name: 'Послуги', url: '/poslugy/' },
        { name: area.navTitle, url: `/poslugy/${area.slug}/` },
      ]} />

      <div class="max-w-3xl space-y-6">
        <h1 class="text-3xl/tight sm:text-4xl/tight md:text-5xl/tight font-bold text-heading-1">
          {area.h1}
        </h1>
        <Paragraph>{area.intro}</Paragraph>
        <div class="flex flex-col sm:flex-row gap-4">
          <button
            type="button"
            data-contact-button
            class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-primary text-white hover:bg-primary/90 transition-colors font-medium"
          >
            Безкоштовна консультація
          </button>
          <a
            href={contact.phoneHref}
            data-gtm-element="practice-hero-phone"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full border border-box-border text-heading-1 hover:border-primary hover:text-primary transition-colors"
          >
            {contact.phoneDisplay}
          </a>
        </div>
        <ContactTelegram />
      </div>
    </Container>

    <Container>
      <div class="grid lg:grid-cols-3 gap-10 lg:gap-12 border-t border-box-border pt-10">
        <div class="lg:col-span-2 space-y-12">
          {area.serviceGroups.map((group) => (
            <section class="space-y-6">
              <h2 class="text-xl md:text-2xl font-bold font-display uppercase text-primary">{group.audience}</h2>
              <div class="grid md:grid-cols-2 gap-x-10 gap-y-8">
                {group.services.map((service) => (
                  <div class="space-y-3">
                    <h3 class="text-lg font-semibold text-heading-1">{service.title}</h3>
                    <ul class="space-y-2">
                      {service.items.map((item) => (
                        <li class="flex items-start gap-3 text-heading-3">
                          <span aria-hidden="true" class="mt-2.5 w-1.5 h-1.5 rounded-full bg-primary shrink-0"></span>
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </section>
          ))}
        </div>

        <aside class="lg:sticky lg:top-32 self-start space-y-5 p-6 lg:p-8 rounded-3xl border border-box-border bg-box-bg">
          <h2 class="text-sm font-bold uppercase tracking-[0.25em] text-heading-3">Ключовий контакт</h2>
          <div class="space-y-1">
            <a href={`/komanda/#${keyContact.id}`} class="text-xl font-bold text-heading-1 hover:text-primary transition-colors">
              {keyContact.givenName} {keyContact.familyName}
            </a>
            <p class="text-primary font-medium">{keyContact.jobTitle}</p>
          </div>
          <ul class="flex flex-wrap gap-2">
            {keyContact.specializations.map((s) => (
              <li class="px-3 py-1 rounded-full bg-primary/10 text-primary text-sm">{s}</li>
            ))}
          </ul>
          <div class="space-y-2 text-sm">
            <a href={contact.phoneHref} data-gtm-element="practice-contact-phone" class="block text-heading-2 hover:text-primary">{contact.phoneDisplay}</a>
            <a href={contact.emailHref} data-gtm-element="practice-contact-email" class="block text-heading-2 hover:text-primary">{contact.email}</a>
          </div>
          <button
            type="button"
            data-contact-button
            class="w-full inline-flex items-center justify-center px-6 py-3 rounded-full bg-primary text-white hover:bg-primary/90 transition-colors font-medium"
          >
            Записатися на консультацію
          </button>
        </aside>
      </div>
    </Container>

    <Container>
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16">
        <section>
          <h2 class="text-xl md:text-2xl font-semibold text-heading-1 mb-6">Коли варто звернутися</h2>
          <ul class="space-y-4">
            {area.whenToContact.map((point) => (
              <li class="flex items-start gap-3 text-heading-3">
                <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 mt-0.5 shrink-0 text-primary">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>{point}</span>
              </li>
            ))}
          </ul>
        </section>

        <section>
          <h2 class="text-xl md:text-2xl font-semibold text-heading-1 mb-6">Як ми працюємо</h2>
          <ol class="space-y-6">
            {area.process.map((step, index) => (
              <li class="flex gap-4">
                <span class="flex items-center justify-center w-8 h-8 rounded-full bg-primary/10 text-primary font-semibold shrink-0">
                  {index + 1}
                </span>
                <div>
                  <p class="font-semibold text-heading-2">{step.title}</p>
                  <p class="text-heading-3 mt-1">{step.text}</p>
                </div>
              </li>
            ))}
          </ol>
        </section>
      </div>
    </Container>

    <Container className="space-y-10">
      <h2 class="text-xl md:text-2xl font-semibold text-heading-1 text-center">Часті запитання</h2>
      <div class="max-w-3xl mx-auto divide-y divide-box-border rounded-2xl border border-box-border bg-box-bg">
        {area.faqs.map((faq) => (
          <details class="group p-6">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-medium text-heading-1 marker:content-none">
              {faq.question}
              <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 shrink-0 transition-transform duration-200 group-open:rotate-45">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
              </svg>
            </summary>
            <p class="mt-4 text-heading-3 leading-relaxed">{faq.answer}</p>
          </details>
        ))}
      </div>
    </Container>

    {relatedPosts.length > 0 && (
      <Container className="space-y-6">
        <h2 class="text-xl md:text-2xl font-semibold text-heading-1">Корисні статті</h2>
        <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {relatedPosts.map((post) => (
            <li>
              <a href={`/blog/${post.id}/`} class="block h-full p-5 rounded-2xl border border-box-border bg-box-bg hover:border-primary transition-colors">
                <span class="font-medium text-heading-2">{post.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </Container>
    )}

    <Container className="space-y-6">
      <h2 class="text-xl md:text-2xl font-semibold text-heading-1">Інші послуги</h2>
      <div class="grid sm:grid-cols-3 gap-4">
        {related.map((item) => (
          <a href={`/poslugy/${item.slug}/`} class="p-5 rounded-2xl border border-box-border bg-box-bg hover:border-primary transition-colors">
            <span class="font-medium text-heading-2">{item.navTitle}</span>
          </a>
        ))}
      </div>
    </Container>

    <Container>
      <div class="w-full relative py-10 md:py-14 px-6 md:px-10 bg-ink overflow-hidden">
        <span class="absolute -right-10 -top-10 w-40 h-40 rounded-full bg-primary/20 blur-3xl"></span>
        <div class="relative grid lg:grid-cols-2 gap-10 lg:gap-14 items-start max-w-5xl mx-auto">
          <div>
            <h2 class="text-2xl md:text-3xl font-bold text-white">Потрібна консультація адвоката?</h2>
            <p class="pt-4 text-white/70 md:text-lg">
              Опишіть свою ситуацію — адвокат з напряму «{area.navTitle.toLowerCase()}» зв'яжеться з вами.
              Перша консультація безкоштовна.
            </p>
            <div class="pt-8 flex flex-col sm:flex-row gap-4">
              <a
                href={contact.phoneHref}
                data-gtm-element="practice-phone"
                class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full border border-white/25 text-white hover:border-primary hover:text-primary transition-colors"
              >
                <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                </svg>
                {contact.phoneDisplay}
              </a>
              <ContactTelegram />
            </div>
          </div>
          <div class="bg-white/5 border border-white/10 rounded-2xl p-6 sm:p-8">
            <LeadForm source={`practice-${area.slug}`} dark />
          </div>
        </div>
      </div>
    </Container>
  </main>
</Layout>
