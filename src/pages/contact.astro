---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/shared/ContactForm.astro";

// Contact page structured data
const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Контакти Lex Duo",
  "description": "Зв'яжіться з адвокатами Lex Duo для отримання юридичної консультації та допомоги",
  "url": "https://www.lexduo.com.ua/contact",
  "mainEntity": {
    "@type": "Organization",
    "name": "Lex Duo",
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "customer service",
      "availableLanguage": ["uk", "en", "ru"],
      "areaServed": "UA"
    }
  }
};
---

<Layout 
  title="Контакти | Lex Duo - Адвокати в Києві"
  description="Зв'яжіться з адвокатами Lex Duo для отримання професійної юридичної консультації та допомоги. Кримінальне право, цивільне право, військове право."
>
  <!-- Contact Page Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(contactSchema, null, 2)}></script>
  
  <!-- Contact Page Meta Tags -->
  <meta name="language" content="uk" />
  <meta name="geo.region" content="UA-30" />
  <meta name="geo.placename" content="Київ" />
  <meta name="keywords" content="контакти адвоката, юридична консультація, адвокат Київ, Lex Duo, адвокати Кушніренко, кримінальне право, цивільне право, військове право, юридична допомога, правова консультація, захист прав, судовий захист, адвокатська компанія, юридичні послуги, правовий супровід, адвокатська фірма Київ, адвокат захист, мобілізація, військовослужбовці, адвокат по кримінальних справах, адвокат по цивільних справах, адвокат по господарських справах, юридична консультація, правова допомога, судові спори, адвокатська практика, сімейне право, трудове право, податкове право, адміністративне право, конституційне право, міжнародне право, корпоративне право, нерухомість, спадщина, шлюбні спори, розлучення, аліменти, трудові спори, податкові спори, адміністративні спори, конституційні спори, міжнародні спори, корпоративні спори, захист бізнесу, юридичний аудит, правова експертиза, судове представництво, апеляція, касація, виконавче провадження, медичне право, страхове право, банківське право, інтелектуальна власність, авторське право, товарні знаки, патенти, ліцензування, регулювання, комплаєнс, антимонопольне право, конкурентне право, екологічне право, земельне право, будівельне право, транспортне право, митне право, валютне право, фінансове право, банкрутство, реструктуризація, ліквідація, реєстрація підприємств, договірне право, позовна давність, захист споживачів, захист персональних даних, GDPR, інформаційне право, кібербезпека, цифрове право, блокчейн, криптовалюти, NFT, метавсесвіт, штучний інтелект, машинне навчання, автоматизація, роботизація, цифрова трансформація, електронний документообіг, електронний суд, електронна комерція, електронні платежі, електронна підпис, електронна пошта, електронні комунікації, електронні послуги, електронний уряд, електронна демократія, електронне голосування, електронна освіта, електронна медицина, електронна фінансова звітність, електронна податкова звітність, електронна статистична звітність, електронна банківська звітність, електронна страхова звітність, електронна аудиторська звітність, електронна консалтингова звітність, електронна юридична звітність, електронна нотаріальна звітність, електронна судова звітність, електронна правоохоронна звітність, електронна митна звітність" />
  
  <section class="min-h-screen flex items-center justify-center bg-body py-16">
    <div class="w-full max-w-lg bg-white dark:bg-box-bg rounded-2xl shadow-lg p-8 mx-4">
      <h1 class="text-3xl font-bold text-heading-1 mb-6 text-center">Зв'яжіться з нами</h1>
      <ContactForm />
    </div>
  </section>
</Layout> 