---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import Container from "../components/shared/Container.astro";
import Paragraph from "../components/shared/Paragraph.astro";
import LeadForm from "../components/shared/LeadForm.astro";
import ContactTelegram from "../components/shared/ContactTelegram.astro";
import Breadcrumbs from "../components/seo/Breadcrumbs.astro";
import { contact } from "../config/contact";

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "Контакти Lex Duo",
  description:
    "Зв'яжіться з адвокатами Lex Duo для отримання юридичної консультації та допомоги",
  url: "https://www.lexduo.com.ua/contact",
  mainEntity: {
    "@type": "LegalService",
    name: "Lex Duo",
    telephone: contact.phoneDisplay,
    email: contact.email,
    address: {
      "@type": "PostalAddress",
      streetAddress: contact.streetAddress,
      addressLocality: contact.addressLocality,
      postalCode: contact.postalCode,
      addressCountry: contact.addressCountry,
    },
    openingHoursSpecification: {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: "09:00",
      closes: "18:00",
    },
  },
};
---

<Layout
  title="Контакти | Lex Duo - Адвокати в Києві"
  description="Зв'яжіться з адвокатами Lex Duo: телефон, Telegram, адреса в Києві. Перша консультація безкоштовна. Кримінальне, цивільне та військове право."
>
  <script type="application/ld+json" set:html={JSON.stringify(contactSchema, null, 2)} />

  <main id="main-content" class="overflow-hidden pt-32 lg:pt-36 pb-20">
    <Container className="space-y-10">
      <Breadcrumbs
        items={[
          { name: "Головна", url: "/" },
          { name: "Контакти", url: "/contact/" },
        ]}
      />

      <div class="max-w-3xl space-y-4">
        <h1 class="text-3xl/tight sm:text-4xl/tight md:text-5xl/tight font-bold text-heading-1">
          Зв'яжіться з нами
        </h1>
        <Paragraph>
          Перша консультація безкоштовна. Опишіть свою ситуацію — і адвокат Lex Duo
          зв'яжеться з вами протягом робочого дня, щоб пояснити, які кроки варто зробити далі.
        </Paragraph>
      </div>

      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-start">
        <div class="rounded-2xl border border-box-border bg-box-bg p-6 sm:p-8 shadow-lg shadow-box-shadow">
          <h2 class="text-xl font-bold text-heading-1 mb-1">Залишити заявку</h2>
          <p class="text-heading-3 text-sm mb-6">Заповніть форму — ми передзвонимо.</p>
          <LeadForm source="contact-page" />
        </div>

        <div class="space-y-8">
          <div class="space-y-5">
            <h2 class="text-xl font-bold text-heading-1">Наші контакти</h2>

            <a href={contact.phoneHref} data-gtm-element="contact-page-phone" class="flex items-start gap-4 group">
              <span class="rounded-xl bg-primary/10 text-primary p-3 shrink-0">
                <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                </svg>
              </span>
              <span>
                <span class="block text-sm text-heading-3">Телефон</span>
                <span class="block text-lg font-semibold text-heading-1 group-hover:text-primary transition-colors">
                  {contact.phoneDisplay}
                </span>
              </span>
            </a>

            <a href={contact.emailHref} class="flex items-start gap-4 group">
              <span class="rounded-xl bg-primary/10 text-primary p-3 shrink-0">
                <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                </svg>
              </span>
              <span>
                <span class="block text-sm text-heading-3">Email</span>
                <span class="block text-lg font-semibold text-heading-1 group-hover:text-primary transition-colors">
                  {contact.email}
                </span>
              </span>
            </a>

            <div class="flex items-start gap-4">
              <span class="rounded-xl bg-primary/10 text-primary p-3 shrink-0">
                <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                </svg>
              </span>
              <span>
                <span class="block text-sm text-heading-3">Адреса</span>
                <span class="block text-lg font-semibold text-heading-1">
                  {contact.addressLocality}, {contact.streetAddress}
                </span>
              </span>
            </div>

            <div class="flex items-start gap-4">
              <span class="rounded-xl bg-primary/10 text-primary p-3 shrink-0">
                <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </span>
              <span>
                <span class="block text-sm text-heading-3">Графік роботи</span>
                <span class="block text-lg font-semibold text-heading-1">{contact.openingHours}</span>
              </span>
            </div>
          </div>

          <div class="pt-2">
            <p class="text-heading-3 mb-4">Зручніше в месенджері?</p>
            <ContactTelegram />
          </div>
        </div>
      </div>
    </Container>
  </main>
</Layout>
