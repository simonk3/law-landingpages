---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import Container from "../components/shared/Container.astro";
import Paragraph from "../components/shared/Paragraph.astro";
import Breadcrumbs from "../components/seo/Breadcrumbs.astro";
import LeadForm from "../components/shared/LeadForm.astro";
import { attorneys } from "../data/attorneys";
import { contact } from "../config/contact";

const attorneySchema = {
  "@context": "https://schema.org",
  "@type": "LegalService",
  name: "Lex Duo",
  url: "https://www.lexduo.com.ua",
  telephone: contact.phoneDisplay,
  employee: attorneys.map((a) => ({
    "@type": "Person",
    name: a.name,
    jobTitle: a.role,
    knowsAbout: a.specializations,
    worksFor: { "@type": "Organization", name: "Lex Duo" },
  })),
};
---

<Layout
  title="Наші адвокати | Lex Duo — Адвокати Кушніренко в Києві"
  description="Команда адвокатів Lex Duo у Києві: досвід, спеціалізація та свідоцтва про право на заняття адвокатською діяльністю. Перша консультація безкоштовна."
>
  <script type="application/ld+json" set:html={JSON.stringify(attorneySchema, null, 2)} />

  <main id="main-content" class="overflow-hidden pt-32 lg:pt-36 pb-20">
    <Container className="space-y-12">
      <Breadcrumbs
        items={[
          { name: "Головна", url: "/" },
          { name: "Адвокати", url: "/advokaty" },
        ]}
      />

      <div data-reveal-stagger="100" class="max-w-3xl space-y-4">
        <span data-reveal="up" class="block text-xs sm:text-sm font-bold uppercase tracking-[0.25em] text-primary">
          Команда
        </span>
        <h1 data-reveal="up" class="text-3xl/tight sm:text-4xl/tight md:text-5xl/tight font-bold text-heading-1">
          Адвокати Lex Duo
        </h1>
        <Paragraph data-reveal="up">
          Ви маєте знати, хто саме вестиме вашу справу. Нижче — адвокати Lex Duo, їхня
          спеціалізація та підтверджене право на заняття адвокатською діяльністю.
        </Paragraph>
      </div>

      <div data-reveal-stagger="120" class="space-y-10">
        {attorneys.map((person) => (
          <article
            data-reveal="up"
            class="grid md:grid-cols-[260px_1fr] gap-8 p-6 sm:p-8 rounded-2xl border border-box-border bg-box-bg shadow-lg shadow-box-shadow"
          >
            {person.photo && (
              <img
                src={person.photo}
                alt={`${person.name} — ${person.role}, Lex Duo`}
                width="260"
                height="320"
                loading="lazy"
                class="w-full h-64 md:h-80 object-cover rounded-xl"
              />
            )}
            <div class="space-y-4">
              <div>
                <h2 class="text-2xl font-bold text-heading-1">{person.name}</h2>
                <p class="text-primary font-medium mt-1">{person.role}</p>
              </div>

              <Paragraph>{person.bio}</Paragraph>

              <dl class="grid sm:grid-cols-2 gap-4 text-sm pt-2">
                <div>
                  <dt class="text-heading-3">Досвід</dt>
                  <dd class="text-heading-1 font-medium mt-1">{person.experience}</dd>
                </div>
                <div>
                  <dt class="text-heading-3">Освіта</dt>
                  <dd class="text-heading-1 font-medium mt-1">{person.education.join("; ")}</dd>
                </div>
                <div class="sm:col-span-2">
                  <dt class="text-heading-3">Підтвердження кваліфікації</dt>
                  <dd class="text-heading-1 font-medium mt-1">{person.licence}</dd>
                </div>
              </dl>

              <div class="flex flex-wrap gap-2 pt-2">
                {person.specializations.map((tag) => (
                  <span class="text-xs font-medium px-3 py-1.5 rounded-full bg-primary/10 text-primary">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="grid lg:grid-cols-2 gap-10 lg:gap-14 items-start bg-ink p-6 sm:p-10 relative overflow-hidden">
        <span class="absolute -right-10 -top-10 w-40 h-40 rounded-full bg-primary/20 blur-3xl"></span>
        <div class="relative">
          <h2 class="text-2xl md:text-3xl font-bold text-white">Отримати консультацію</h2>
          <p class="pt-4 text-white/70 md:text-lg">
            Опишіть ситуацію — ми скажемо, чи можемо допомогти, і що робити далі.
            Перша консультація безкоштовна.
          </p>
          <a
            href={contact.phoneHref}
            data-gtm-element="attorneys-phone"
            class="mt-8 inline-flex items-center gap-2 px-6 py-3 rounded-full border border-white/25 text-white hover:border-primary hover:text-primary transition-colors"
          >
            {contact.phoneDisplay}
          </a>
        </div>
        <div class="relative bg-white/5 border border-white/10 rounded-2xl p-6 sm:p-8">
          <LeadForm source="attorneys-page" dark />
        </div>
      </div>
    </Container>
  </main>
</Layout>
