---
import "../styles/global.css"
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import Services from '../components/sections/Services.astro';
import AboutUs from '../components/sections/AboutUs.astro';
import ByNumber from '../components/sections/ByNumber.astro';
import Features from '../components/sections/Features.astro';
import FAQ from '../components/sections/FAQ.astro';
import CTA from '../components/sections/CTA.astro';
 
---

<Layout
	title="Адвокат у Києві — кримінальні та військові справи | Lex Duo"
	description="Адвокати Кушніренко (Lex Duo) — правовий захист у Києві та по всій Україні. Кримінальні, військові, сімейні справи. Безкоштовна консультація."
>
	<main id="main-content" class="flex flex-col gap-y-20 md:gap-y-32 overflow-hidden">
		<Hero/>
		<ByNumber/>
		<Services/>
		<AboutUs/>
		<Features/>
		<FAQ/>
		<CTA/>
	</main>
</Layout>