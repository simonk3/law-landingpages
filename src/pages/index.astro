---
import "../styles/global.css"
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import Services from '../components/sections/Services.astro';
import AboutUs from '../components/sections/AboutUs.astro';
import Features from '../components/sections/Features.astro';
import CTA from '../components/sections/CTA.astro';
 
---

<Layout title="Адвокати Кушніренко | Київ">
	<!-- Additional Homepage Meta Tags -->
	<meta name="subject" content="Юридичні послуги в Києві" />
	<meta name="classification" content="Адвокатські послуги" />
	<meta name="category" content="Юридична допомога" />
	<meta name="coverage" content="Україна" />
	<meta name="distribution" content="global" />
	<meta name="rating" content="general" />
	<meta name="revisit-after" content="7 days" />
	<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
	<meta name="googlebot" content="index, follow" />
	<meta name="bingbot" content="index, follow" />
	<meta name="yandex" content="index, follow" />
	
	<main class="flex flex-col gap-y-20 md:gap-y-32 overflow-hidden">
		<Hero/>
		<Services/>
		<AboutUs/>
		<Features/>
		<CTA/>
	</main>
</Layout>