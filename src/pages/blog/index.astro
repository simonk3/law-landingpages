---
import "../../styles/global.css"
import Layout from '../../layouts/Layout.astro';
import { client } from '../../lib/prismic';
import type { PrismicDocument } from '@prismicio/client';

interface BlogPostData {
  uid: string;
  title: Array<{
    type: string;
    text: string;
    spans: any[];
  }>;
  text: string;
  body: Array<{
    slice_type: 'rich_text';
    items: Array<{
      richtext: Array<{
        type: string;
        text: string;
        spans: any[];
      }>;
    }>;
  }>;
}

let posts: PrismicDocument<BlogPostData>[] = [];
let customTypes: string[] = [];

try {
  // First, let's check what Custom Types are available
  const customTypesResponse = await fetch('https://bureau-kush.cdn.prismic.io/api/v2');
  const customTypesData = await customTypesResponse.json();
  customTypes = Object.keys(customTypesData.types);
  console.log('Available Custom Types:', customTypes);

  // Then try to fetch posts
  posts = await client.getAllByType('blog-post', {
    orderings: {
      field: 'document.first_publication_date',
      direction: 'desc',
    },
  });
  console.log('Raw Prismic response:', JSON.stringify(posts, null, 2));
} catch (error) {
  console.error('Error:', error);
}
---

<Layout title="Блог">
  <main class="container mx-auto px-4 py-16">
    <h1 class="text-4xl font-bold mb-8 text-heading-1">Блог</h1>
    
    <!-- Debug info -->
    <div class="mb-8 p-4 bg-gray-100 dark:bg-gray-800 rounded">
      <h2 class="text-lg font-bold mb-2">Debug Info:</h2>
      <p>Number of posts: {posts.length}</p>
      <p>Available Custom Types: {customTypes.join(', ')}</p>
      <pre class="text-xs overflow-auto">
        {JSON.stringify(posts, null, 2)}
      </pre>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {posts.map((post) => {
        console.log('Processing post:', post);
        return (
          <article class="bg-box border border-box-border rounded-lg overflow-hidden shadow-sm">
            <div class="p-6">
              <h2 class="text-xl font-semibold mb-2 text-heading-2">
                <a href={`/blog/${post.uid}`} class="hover:text-primary">
                  {post.data.title?.[0]?.text || 'No Title'}
                </a>
              </h2>
              <p class="text-heading-3 mb-4">
                {new Date(post.first_publication_date).toLocaleDateString('uk-UA')}
              </p>
              <p class="text-heading-3 mb-4">{post.data.text || 'No excerpt'}</p>
              <a
                href={`/blog/${post.uid}`}
                class="text-primary hover:text-primary-dark font-medium"
              >
                Читати далі →
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </main>
</Layout> 