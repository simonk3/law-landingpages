---
import { getCollection } from 'astro:content';
import { advocates } from '../../data/advocates';
import "../../styles/global.css"
import Layout from '../../layouts/Layout.astro';

// Counted off the markdown body, not the excerpt — the excerpt gave every card the
// same wrong "2 хв".
const countWords = (body: string | undefined) =>
  (body ?? '')
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/!?\[([^\]]*)\]\([^)]*\)/g, '$1')
    .replace(/[#>*_`|-]/g, ' ')
    .trim()
    .split(/\s+/)
    .filter(Boolean).length;

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<Layout
  title="Юридичний блог: статті адвокатів Lex Duo"
  description="Юридичні статті та поради від адвокатів Lex Duo: мобілізація, ВЛК, виплати військовим, кримінальні та цивільні справи. Практичні розбори українського права."
>
  <!-- Blog Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Blog',
    '@id': `${Astro.url.origin}/blog/#blog`,
    name: 'Блог Lex Duo',
    description: 'Юридичні статті та поради від адвокатів Lex Duo',
    url: `${Astro.url.origin}/blog/`,
    inLanguage: 'uk-UA',
    publisher: { '@id': `${Astro.url.origin}/#organization` },
    blogPost: posts.slice(0, 5).map((post) => ({
      '@type': 'BlogPosting',
      headline: post.data.title,
      description: post.data.description.slice(0, 160),
      datePublished: post.data.pubDate.toISOString(),
      dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
      url: `${Astro.url.origin}/blog/${post.id}/`,
      author: { '@id': `${Astro.url.origin}/komanda/#${advocates[0].id}` },
      publisher: { '@id': `${Astro.url.origin}/#organization` },
      articleSection: 'Юридичні статті',
      wordCount: countWords(post.body)
    }))
  })}>
  </script>

  <!-- Breadcrumbs Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Головна', item: `${Astro.url.origin}/` },
      { '@type': 'ListItem', position: 2, name: 'Блог', item: `${Astro.url.origin}/blog/` }
    ]
  })}>
  </script>

  <main id="main-content" class="container mx-auto px-4 py-16">
    <!-- Breadcrumbs -->
    <nav aria-label="Breadcrumb" class="mb-8">
      <ol class="flex items-center space-x-2 text-sm text-heading-3">
        <li><a href="/" class="hover:text-primary transition-colors">Головна</a></li>
        <li>/</li>
        <li class="text-gray-500">Блог</li>
      </ol>
    </nav>

    <header class="text-center mb-12">
      <h1 class="text-4xl font-bold mb-4 text-heading-1">Блог</h1>
      <p class="text-lg text-heading-3 max-w-2xl mx-auto">
        Актуальні юридичні статті, поради та новини від адвокатів Lex Duo.
        Кримінальне право, цивільні справи, військове право та багато іншого.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {/* The first row is above the fold on desktop; the rest stay lazy. */}
      {posts.map((post, index) => {
        const readingTime = Math.max(1, Math.ceil(countWords(post.body) / 180));
        return (
        <article class="bg-box border border-box-border rounded-lg overflow-hidden shadow-sm hover:shadow-md transition-shadow duration-300" itemscope itemtype="https://schema.org/BlogPosting">
          <div class="aspect-[16/9] overflow-hidden">
            <img
              src={post.data.heroImage}
              alt={post.data.heroAlt}
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
              loading={index < 3 ? 'eager' : 'lazy'}
              width="800"
              height="450"
              itemprop="image"
            />
          </div>
          <div class="p-6">
            <h2 class="text-xl font-semibold mb-2 text-heading-2">
              <a href={`/blog/${post.id}/`} class="hover:text-primary transition-colors duration-300" itemprop="headline">
                {post.data.title}
              </a>
            </h2>
            <div class="flex items-center gap-4 text-heading-3 text-sm mb-4">
              <time datetime={post.data.pubDate.toISOString()} itemprop="datePublished">
                {post.data.pubDate.toLocaleDateString('uk-UA', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
              <span>•</span>
              <span>{readingTime} хв</span>
            </div>
            <p class="text-heading-3 mb-4 line-clamp-3" itemprop="description">{post.data.description}</p>
            <a
              href={`/blog/${post.id}/`}
              class="inline-flex items-center text-primary hover:text-primary-dark font-medium transition-colors duration-300"
              itemprop="url"
            >
              Читати далі
              <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-1" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </a>
          </div>
        </article>
      )})}
    </div>

    {posts.length > 0 && (
      <div class="mt-12 text-center text-heading-3">
        <p>Показано {posts.length} статей</p>
      </div>
    )}
  </main>
</Layout>
