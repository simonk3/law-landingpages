---
import "../../styles/global.css"
import Layout from '../../layouts/Layout.astro';
import { client } from '../../lib/prismic';
import type { PrismicDocument } from '@prismicio/client';

interface BlogPostData {
  uid: string;
  title: Array<{
    type: string;
    text: string;
    spans: any[];
  }>;
  text: string;
  body: Array<{
    slice_type: 'rich_text';
    items: Array<{
      richtext: Array<{
        type: string;
        text?: string;
        url?: string;
        alt?: string;
        spans: any[];
      }>;
    }>;
  }>;
  [key: string]: any; // Add index signature
}

let posts: PrismicDocument<BlogPostData>[] = [];

try {
  posts = await client.getAllByType('blog-post', {
    orderings: {
      field: 'document.first_publication_date',
      direction: 'desc',
    },
  });
} catch (error) {
  console.error('Error:', error);
}

function resolveCardImage(post: PrismicDocument<BlogPostData>): { url: string; alt: string } | null {
  for (const slice of post.data?.body || []) {
    if (slice.slice_type === 'rich_text') {
      for (const item of slice.items || []) {
        for (const node of item.richtext || []) {
          if (node.type === 'image' && node.url) {
            return { url: node.url, alt: node.alt || (post.data.title?.[0]?.text || 'Blog post image') };
          }
        }
      }
    }
  }
  return null;
}
---

<Layout 
  title="Блог | Lex Duo - Юридичні статті та поради"
  description="Читайте актуальні юридичні статті, поради та новини від адвокатів Lex Duo. Кримінальне право, цивільні справи, військове право."
>
  <!-- Blog Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'Lex Duo Blog',
    description: 'Юридичні статті та поради від адвокатів Lex Duo',
    url: `${Astro.url.origin}/blog`,
    publisher: {
      '@type': 'Organization',
      name: 'Lex Duo',
      logo: {
        '@type': 'ImageObject',
        url: `${Astro.url.origin}/favicon.svg`
      }
    },
    blogPost: posts.slice(0, 5).map(post => ({
      '@type': 'BlogPosting',
      headline: post.data.title?.[0]?.text,
      description: post.data.text?.slice(0, 160),
      datePublished: post.first_publication_date,
      url: `${Astro.url.origin}/blog/${post.uid}`,
      author: {
        '@type': 'Organization',
        name: 'Lex Duo'
      }
    }))
  })}>
  </script>

  <!-- Open Graph Meta Tags -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content="Блог | Lex Duo - Юридичні статті та поради" />
  <meta property="og:description" content="Читайте актуальні юридичні статті, поради та новини від адвокатів Lex Duo. Кримінальне право, цивільні справи, військове право." />
  <meta property="og:url" content={`${Astro.url.origin}/blog`} />

  <main class="container mx-auto px-4 py-16">
    <!-- Breadcrumbs -->
    <nav aria-label="Breadcrumb" class="mb-8">
      <ol class="flex items-center space-x-2 text-sm text-heading-3">
        <li><a href="/" class="hover:text-primary transition-colors">Головна</a></li>
        <li>/</li>
        <li class="text-gray-500">Блог</li>
      </ol>
    </nav>

    <header class="text-center mb-12">
      <h1 class="text-4xl font-bold mb-4 text-heading-1">Блог</h1>
      <p class="text-lg text-heading-3 max-w-2xl mx-auto">
        Актуальні юридичні статті, поради та новини від адвокатів Lex Duo. 
        Кримінальне право, цивільні справи, військове право та багато іншого.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {posts.map((post) => {
        const cardImg = resolveCardImage(post);
        const readingTime = Math.ceil((post.data.text?.length || 0) / 200);
        return (
        <article class="bg-box border border-box-border rounded-lg overflow-hidden shadow-sm hover:shadow-md transition-shadow duration-300">
          {cardImg && (
            <div class="aspect-[16/9] overflow-hidden">
              <img
                src={`${cardImg.url}?auto=compress,format&w=600`}
                srcset={`${cardImg.url}?auto=compress,format&w=400 400w, ${cardImg.url}?auto=compress,format&w=600 600w, ${cardImg.url}?auto=compress,format&w=800 800w`}
                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                alt={cardImg.alt}
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                loading="lazy"
                width="800"
                height="450"
              />
            </div>
          )}
          <div class="p-6">
            <h2 class="text-xl font-semibold mb-2 text-heading-2">
              <a href={`/blog/${post.uid}`} class="hover:text-primary transition-colors duration-300">
                {post.data.title?.[0]?.text || 'No Title'}
              </a>
            </h2>
            <div class="flex items-center gap-4 text-heading-3 text-sm mb-4">
              <time datetime={post.first_publication_date}>
                {new Date(post.first_publication_date).toLocaleDateString('uk-UA', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric'
                })}
              </time>
              <span>•</span>
              <span>{readingTime} хв</span>
            </div>
            <p class="text-heading-3 mb-4 line-clamp-3">{post.data.text || ''}</p>
            <a
              href={`/blog/${post.uid}`}
              class="inline-flex items-center text-primary hover:text-primary-dark font-medium transition-colors duration-300"
            >
              Читати далі
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-1" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </a>
          </div>
        </article>
      )})}
    </div>

    {posts.length === 0 && (
      <div class="text-center py-12">
        <p class="text-heading-3 text-lg">Поки що немає статей. Завітайте пізніше!</p>
      </div>
    )}
  </main>
</Layout> 