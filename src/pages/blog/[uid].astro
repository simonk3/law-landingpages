---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { advocates } from '../../data/advocates';
import "../../styles/global.css"
import Layout from '../../layouts/Layout.astro';
import BlogCTA from '../../components/blocks/BlogCTA.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft))
    .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

  return posts.map((post) => ({
    // entry.id is the filename, which is the slug the live URLs and the vercel.json
    // 301s already point at. Deriving the path any other way re-breaks those URLs.
    params: { uid: post.id },
    props: {
      post,
      relatedPosts: posts.filter((p) => p.id !== post.id).slice(0, 3),
    },
  }));
}

const { post, relatedPosts } = Astro.props as {
  post: CollectionEntry<'blog'>;
  relatedPosts: CollectionEntry<'blog'>[];
};
const { data } = post;
const { Content } = await render(post);

// Social cards and Article rich results need a raster image: neither Google nor the
// social crawlers render SVG. The hero below is the SVG; this stays the shared JPEG.
const articleImage = new URL('/images/og-1200x630.jpg', Astro.site).href;

// Google cuts titles near 60 characters. Appending the brand unconditionally pushed
// most posts past that, so the suffix is dropped when it would only be truncated
// anyway — the post's own words are worth more there than the brand name.
const pageTitle = data.title.length <= 48 ? `${data.title} | Lex Duo` : data.title;

// Counted off the actual markdown body, not the excerpt — the excerpt gave every post
// the same wrong "2 хв". Strip markdown syntax so markers are not counted as words.
const bodyText = post.body
  ?.replace(/```[\s\S]*?```/g, ' ')
  .replace(/!?\[([^\]]*)\]\([^)]*\)/g, '$1')
  .replace(/[#>*_`|-]/g, ' ') ?? '';
const wordCount = bodyText.trim().split(/\s+/).filter(Boolean).length;
// ~180 words per minute is the usual figure for Ukrainian prose.
const readingTime = Math.max(1, Math.ceil(wordCount / 180));

// Google truncates descriptions near 160 characters, and a hard slice() cut words in
// half mid-snippet. This trims at the last word boundary instead.
const summarise = (value: string | undefined, limit = 160) => {
  const text = (value ?? '').replace(/\s+/g, ' ').trim();
  if (text.length <= limit) return text;
  const cut = text.slice(0, limit);
  return `${cut.slice(0, cut.lastIndexOf(' ')).replace(/[.,;:—-]$/, '')}…`;
};
// Posts are published under the senior advocate's name until the frontmatter carries a
// per-post byline; both advocates are declared on /komanda/.
const blogAuthor = advocates[0];
const summary = summarise(data.description) || 'Читайте статтю на Lex Duo';

// Legal advice is YMYL content: Google weighs who wrote it. The author is the named
// advocate behind the firm, not the firm as an anonymous Organization, and points at
// the same organization entity the layout emits.
// A bare @id: the full Person — certificate number, bar council, registry links —
// is declared on /komanda/, so the byline resolves to a credentialed advocate rather
// than re-stating a thin copy of them on every post.
const articleAuthor = { '@id': `${Astro.url.origin}/komanda/#${blogAuthor.id}` };

const published = data.pubDate.toISOString();
const modified = (data.updatedDate ?? data.pubDate).toISOString();
const fmtDate = (d: Date) =>
  d.toLocaleDateString('uk-UA', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout
  title={pageTitle}
  description={summary}
  ogType="article"
  image={articleImage}
  publishedTime={published}
  modifiedTime={modified}
>
  <!-- Article Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: data.title,
    description: summary,
    image: articleImage,
    inLanguage: 'uk-UA',
    wordCount,
    articleSection: 'Юридичні статті',
    keywords: 'юридична допомога, адвокат, право, Lex Duo, ' + data.title,
    author: articleAuthor,
    publisher: {
      '@type': 'Organization',
      name: 'Lex Duo',
      url: Astro.url.origin,
      logo: {
        '@type': 'ImageObject',
        url: `${Astro.url.origin}/icon-512.png`
      }
    },
    datePublished: published,
    dateModified: modified,
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': Astro.url.href
    },
    isPartOf: {
      '@type': 'Blog',
      name: 'Lex Duo Blog',
      url: `${Astro.url.origin}/blog/`
    }
  })}>
  </script>

  <!-- Breadcrumbs Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Головна', item: `${Astro.url.origin}/` },
      { '@type': 'ListItem', position: 2, name: 'Блог', item: `${Astro.url.origin}/blog/` },
      { '@type': 'ListItem', position: 3, name: data.title, item: Astro.url.href }
    ]
  })}>
  </script>

  <main id="main-content">
  <article class="container mx-auto px-4 py-16">
    <!-- Breadcrumbs -->
    <nav aria-label="Breadcrumb" class="mb-8">
      <ol class="flex items-center space-x-2 text-sm text-heading-3">
        <li><a href="/" class="hover:text-primary transition-colors">Головна</a></li>
        <li>/</li>
        <li><a href="/blog/" class="hover:text-primary transition-colors">Блог</a></li>
        <li>/</li>
        <li class="text-gray-500 truncate max-w-xs">{data.title}</li>
      </ol>
    </nav>

    <header class="max-w-3xl mx-auto mb-fit">
      <div class="space-y-4">
        <h1 class="text-4xl md:text-5xl font-bold text-heading-1 leading-tight">
          {data.title}
        </h1>
        <div class="flex items-center gap-4 text-heading-3 text-sm">
          <time datetime={published}>{fmtDate(data.pubDate)}</time>
          <span>•</span>
          <span>{readingTime} хв читання</span>
        </div>
      </div>
      <div class="mt-8 rounded-xl overflow-hidden">
        <img
          src={data.heroImage}
          alt={data.heroAlt}
          class="w-full h-auto object-cover"
          width="1200"
          height="675"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </header>

    <div class="max-w-3xl mx-auto prose dark:prose-invert prose-lg mt-0">
      <style>
        .prose {
          --tw-prose-body: #4B5563;
          --tw-prose-headings: #111827;
          --tw-prose-links: #2563EB;
          --tw-prose-bold: #111827;
          --tw-prose-counters: #6B7280;
          --tw-prose-bullets: #6B7280;
          --tw-prose-hr: #E5E7EB;
          --tw-prose-quotes: #6B7280;
          --tw-prose-quote-borders: #E5E7EB;
          --tw-prose-captions: #4B5563;
          --tw-prose-code: #111827;
          --tw-prose-pre-code: #4B5563;
          --tw-prose-pre-bg: #F3F4F6;
          --tw-prose-th-borders: #E5E7EB;
          --tw-prose-td-borders: #E5E7EB;
        }

        .dark .prose {
          --tw-prose-body: #9CA3AF;
          --tw-prose-headings: #F3F4F6;
          --tw-prose-links: #60A5FA;
          --tw-prose-bold: #F3F4F6;
          --tw-prose-counters: #9CA3AF;
          --tw-prose-bullets: #9CA3AF;
          --tw-prose-hr: #374151;
          --tw-prose-quotes: #9CA3AF;
          --tw-prose-quote-borders: #374151;
          --tw-prose-captions: #9CA3AF;
          --tw-prose-code: #F3F4F6;
          --tw-prose-pre-code: #9CA3AF;
          --tw-prose-pre-bg: #1F2937;
          --tw-prose-th-borders: #374151;
          --tw-prose-td-borders: #374151;
        }

        /* Ensure proper spacing for the first element in the rich text */
        .prose > *:first-child {
            margin-top: 0;
            padding-top: 0;
        }

        .prose h1 { font-size: 2.5em; margin-top: 1.5em; margin-bottom: 0.8em; line-height: 1.2; }
        .prose h2 { font-size: 1.8em; margin-top: 2.5em; margin-bottom: 0.6em; line-height: 1.3; }
        .prose h3 { font-size: 1.5em; margin-top: 2em; margin-bottom: 0.5em; line-height: 1.4; }
        .prose p { margin-top: 1.25em; margin-bottom: 1.25em; line-height: 1.75; }
        .prose a { color: var(--tw-prose-links); text-decoration: none; font-weight: 500; }
        .prose a:hover { text-decoration: underline; }
        .prose ul, .prose ol { margin-top: 1.25em; margin-bottom: 1.25em; padding-left: 1.625em; }
        .prose li { margin-top: 0.5em; margin-bottom: 0.5em; }
        .prose blockquote {
          font-style: italic;
          border-left-width: 0.25rem;
          border-left-color: var(--tw-prose-quote-borders);
          padding-left: 1em;
          margin: 1.6em 0;
        }
        .prose img { margin-top: 2.5em; margin-bottom: 2.5em; border-radius: 0.5rem; }
        .prose pre {
          background-color: var(--tw-prose-pre-bg);
          border-radius: 0.5rem;
          padding: 1em;
          overflow-x: auto;
          margin-top: 1.8em;
          margin-bottom: 1.8em;
        }
        .prose code { color: var(--tw-prose-code); font-weight: 600; font-size: 0.875em; }
        .prose pre code {
          background-color: transparent;
          border-width: 0;
          border-radius: 0;
          padding: 0;
          font-weight: 400;
          color: inherit;
          font-size: inherit;
          font-family: inherit;
          line-height: inherit;
        }

        /* Tables arrived with the markdown migration; Prismic rich text had none. */
        .prose table {
          width: 100%;
          margin-top: 2em;
          margin-bottom: 2em;
          border-collapse: collapse;
          font-size: 0.95em;
          display: block;
          overflow-x: auto;
        }
        .prose th, .prose td {
          border: 1px solid var(--tw-prose-td-borders);
          padding: 0.625em 0.875em;
          text-align: left;
          vertical-align: top;
        }
        .prose th { font-weight: 700; color: var(--tw-prose-headings); }
      </style>

      <Content />

      <BlogCTA slug={post.id} />
    </div>

    <!-- Related Posts -->
    {relatedPosts.length > 0 && (
      <section class="mt-16 pt-8 border-t border-box-border">
        <div class="max-w-3xl mx-auto">
          <h2 class="text-2xl font-bold mb-8 text-heading-1">Схожі статті</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {relatedPosts.map((relatedPost) => (
              <article class="bg-box border border-box-border rounded-lg overflow-hidden shadow-sm hover:shadow-md transition-shadow duration-300" itemscope itemtype="https://schema.org/BlogPosting">
                <div class="aspect-[16/9] overflow-hidden">
                  <img
                    src={relatedPost.data.heroImage}
                    alt={relatedPost.data.heroAlt}
                    class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                    width="400"
                    height="225"
                    itemprop="image"
                  />
                </div>
                <div class="p-4">
                  <h3 class="text-lg font-semibold mb-2 text-heading-2">
                    <a href={`/blog/${relatedPost.id}/`} class="hover:text-primary transition-colors duration-300" itemprop="headline">
                      {relatedPost.data.title}
                    </a>
                  </h3>
                  <p class="text-heading-3 text-sm mb-2">
                    <time datetime={relatedPost.data.pubDate.toISOString()} itemprop="datePublished">
                      {relatedPost.data.pubDate.toLocaleDateString('uk-UA', { year: 'numeric', month: 'short', day: 'numeric' })}
                    </time>
                  </p>
                  <p class="text-heading-3 text-sm line-clamp-2" itemprop="description">{relatedPost.data.description}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}
  </article>
  </main>
</Layout>
