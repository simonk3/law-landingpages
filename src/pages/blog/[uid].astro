---
import "../../styles/global.css"
import Layout from '../../layouts/Layout.astro';
import { client, htmlSerializer } from '../../lib/prismic';
import * as prismicH from '@prismicio/helpers';
import type { PrismicDocument } from '@prismicio/client';

interface BlogPostData {
  uid: string;
  title: Array<{
    type: string;
    text: string;
    spans: any[];
  }>;
  text: string;
  preview_image?: {
    url: string;
    alt?: string;
  };
  body: Array<{
    slice_type: 'rich_text';
    items: Array<{
      richtext: Array<{
        type: string;
        text?: string;
        url?: string;
        alt?: string;
        spans: any[];
      }>;
    }>;
  }>;
  [key: string]: any; // Add index signature
}

export async function getStaticPaths() {
  const posts = await client.getAllByType('blog-post');
  
  return posts.map((post) => {
    // Use custom URL if available, otherwise fallback to default uid
    const urlPath = post.data?.custom_url?.uid || post.uid;
    
    return {
      params: { uid: urlPath },
      props: { post },
    };
  });
}

const { post } = Astro.props as { post: PrismicDocument<BlogPostData> };
const { data } = post;

// Try to resolve a hero image from Prismic content
function resolveHeroImage(): { url: string; alt: string } | null {
  for (const slice of data.body || []) {
    if (slice.slice_type === 'rich_text') {
      for (const item of slice.items || []) {
        for (const node of item.richtext || []) {
          if (node.type === 'image' && node.url) {
            return { url: node.url, alt: node.alt || (data.title?.[0]?.text || 'Blog image') };
          }
        }
      }
    }
  }
  return null;
}

const heroImage = resolveHeroImage();
const readingTime = Math.ceil((data.text?.length || 0) / 200); // ~200 chars per minute

// Get related posts (same category or recent posts)
const allPosts = await client.getAllByType('blog-post');
const relatedPosts = allPosts
  .filter(p => p.uid !== post.uid)
  .slice(0, 3);

const responsive = (url: string) => ({
  src: `${url}${url.includes('?') ? '&' : '?'}auto=compress,format&w=800`,
  src400: `${url}${url.includes('?') ? '&' : '?'}auto=compress,format&w=400`,
  src800: `${url}${url.includes('?') ? '&' : '?'}auto=compress,format&w=800`,
  src1200: `${url}${url.includes('?') ? '&' : '?'}auto=compress,format&w=1200`,
});
---

<Layout 
  title={`${data.title?.[0]?.text} | Lex Duo`}
  description={data.text?.slice(0, 160) || 'Читайте статтю на Lex Duo'}
>
  <!-- Ukrainian Language Meta Tags -->
  <meta name="language" content="uk" />
  <meta name="geo.region" content="UA-30" />
  <meta name="geo.placename" content="Київ" />
  <meta name="keywords" content={`юридична стаття, правові поради, ${data.title?.[0]?.text || ''}, адвокат Київ, юридична допомога, Lex Duo, адвокати Кушніренко, кримінальне право, цивільне право, військове право, захист прав`} />
  <!-- Article Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: data.title?.[0]?.text,
    description: data.text?.slice(0, 160),
    image: heroImage?.url,
    wordCount: data.text?.length || 0,
    articleSection: 'Юридичні статті',
    keywords: 'юридична допомога, адвокат, право, Lex Duo, ' + (data.title?.[0]?.text || ''),
    author: {
      '@type': 'Organization',
      name: 'Lex Duo',
      url: Astro.url.origin,
      logo: {
        '@type': 'ImageObject',
        url: `${Astro.url.origin}/favicon.svg`
      }
    },
    publisher: {
      '@type': 'Organization',
      name: 'Lex Duo',
      url: Astro.url.origin,
      logo: {
        '@type': 'ImageObject',
        url: `${Astro.url.origin}/favicon.svg`
      }
    },
    datePublished: post.first_publication_date,
    dateModified: post.last_publication_date || post.first_publication_date,
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': Astro.url.href
    },
    isPartOf: {
      '@type': 'Blog',
      name: 'Lex Duo Blog',
      url: `${Astro.url.origin}/blog`
    }
  })}>
  </script>

  <!-- Open Graph Meta Tags -->
  <meta property="og:type" content="article" />
  <meta property="og:title" content={data.title?.[0]?.text} />
  <meta property="og:description" content={data.text?.slice(0, 160)} />
  <meta property="og:image" content={heroImage?.url} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:url" content={Astro.url.href} />
  <meta property="og:site_name" content="Lex Duo" />
  <meta property="og:locale" content="uk_UA" />
  <meta property="article:published_time" content={post.first_publication_date} />
  <meta property="article:modified_time" content={post.last_publication_date || post.first_publication_date} />
  <meta property="article:author" content="Lex Duo" />
  <meta property="article:section" content="Юридичні статті" />
  <meta property="article:tag" content="юридична допомога, адвокат, право, Lex Duo" />

  <!-- Twitter Card Meta Tags -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={data.title?.[0]?.text} />
  <meta name="twitter:description" content={data.text?.slice(0, 160)} />
  <meta name="twitter:image" content={heroImage?.url} />
  <meta name="twitter:site" content="@lexduo" />
  <meta name="twitter:creator" content="@lexduo" />

  <!-- Breadcrumbs Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Головна',
        item: Astro.url.origin
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Блог',
        item: `${Astro.url.origin}/blog`
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: data.title?.[0]?.text || 'Стаття',
        item: Astro.url.href
      }
    ]
  })}>
  </script>

  <article class="container mx-auto px-4 py-16">
    <!-- Breadcrumbs -->
    <nav aria-label="Breadcrumb" class="mb-8">
      <ol class="flex items-center space-x-2 text-sm text-heading-3">
        <li><a href="/" class="hover:text-primary transition-colors">Головна</a></li>
        <li>/</li>
        <li><a href="/blog" class="hover:text-primary transition-colors">Блог</a></li>
        <li>/</li>
        <li class="text-gray-500 truncate max-w-xs">{data.title?.[0]?.text}</li>
      </ol>
    </nav>

    <header class="max-w-3xl mx-auto mb-fit">
      <div class="space-y-4">
        <h1 class="text-4xl md:text-5xl font-bold text-heading-1 leading-tight">
          {data.title?.[0]?.text}
        </h1>
        <div class="flex items-center gap-4 text-heading-3 text-sm">
          <time datetime={post.first_publication_date}>
            {new Date(post.first_publication_date).toLocaleDateString('uk-UA', {
              year: 'numeric',
              month: 'long',
              day: 'numeric'
            })}
          </time>
          <span>•</span>
          <span>{readingTime} хв читання</span>
        </div>
      </div>
      {heroImage && (
        <div class="mt-8 rounded-xl overflow-hidden">
          <picture>
            <source type="image/webp" srcset={`${responsive(heroImage.url).src400} 400w, ${responsive(heroImage.url).src800} 800w, ${responsive(heroImage.url).src1200} 1200w`} sizes="(max-width: 768px) 100vw, 800px" />
            <img src={responsive(heroImage.url).src} alt={heroImage.alt} class="w-full h-auto object-cover" width="1200" height="675" loading="eager" fetchpriority="high" decoding="async" />
          </picture>
        </div>
      )}
    </header>

    <div class="max-w-3xl mx-auto prose dark:prose-invert prose-lg mt-0">
      <style>
        .prose {
          --tw-prose-body: #4B5563;
          --tw-prose-headings: #111827;
          --tw-prose-links: #2563EB;
          --tw-prose-bold: #111827;
          --tw-prose-counters: #6B7280;
          --tw-prose-bullets: #6B7280;
          --tw-prose-hr: #E5E7EB;
          --tw-prose-quotes: #6B7280;
          --tw-prose-quote-borders: #E5E7EB;
          --tw-prose-captions: #4B5563;
          --tw-prose-code: #111827;
          --tw-prose-pre-code: #4B5563;
          --tw-prose-pre-bg: #F3F4F6;
          --tw-prose-th-borders: #E5E7EB;
          --tw-prose-td-borders: #E5E7EB;
        }

        .dark .prose {
          --tw-prose-body: #9CA3AF;
          --tw-prose-headings: #F3F4F6;
          --tw-prose-links: #60A5FA;
          --tw-prose-bold: #F3F4F6;
          --tw-prose-counters: #9CA3AF;
          --tw-prose-bullets: #9CA3AF;
          --tw-prose-hr: #374151;
          --tw-prose-quotes: #9CA3AF;
          --tw-prose-quote-borders: #374151;
          --tw-prose-captions: #9CA3AF;
          --tw-prose-code: #F3F4F6;
          --tw-prose-pre-code: #9CA3AF;
          --tw-prose-pre-bg: #1F2937;
          --tw-prose-th-borders: #374151;
          --tw-prose-td-borders: #374151;
        }

        /* Ensure proper spacing for the first element in the rich text */
        .prose > *:first-child {
            margin-top: 0; /* Reset default margin */
            padding-top: 0; /* Reset default padding */
        }

        .prose h1 {
          font-size: 2.5em;
          margin-top: 1.5em;
          margin-bottom: 0.8em;
          line-height: 1.2;
        }

        .prose h2 {
          font-size: 1.8em;
          margin-top: 2.5em;
          margin-bottom: 0.6em;
          line-height: 1.3;
        }

        .prose h3 {
          font-size: 1.5em;
          margin-top: 2em;
          margin-bottom: 0.5em;
          line-height: 1.4;
        }

        .prose p {
          margin-top: 1.25em;
          margin-bottom: 1.25em;
          line-height: 1.75;
        }

        .prose a {
          color: var(--tw-prose-links);
          text-decoration: none;
          font-weight: 500;
        }

        .prose a:hover {
          text-decoration: underline;
        }

        .prose ul, .prose ol {
          margin-top: 1.25em;
          margin-bottom: 1.25em;
          padding-left: 1.625em;
        }

        .prose li {
          margin-top: 0.5em;
          margin-bottom: 0.5em;
        }

        .prose blockquote {
          font-style: italic;
          border-left-width: 0.25rem;
          border-left-color: var(--tw-prose-quote-borders);
          padding-left: 1em;
          margin-left: 0;
          margin-right: 0;
          margin-top: 1.6em;
          margin-bottom: 1.6em;
        }

        .prose img {
          margin-top: 2.5em;
          margin-bottom: 2.5em;
          border-radius: 0.5rem;
        }

        .prose pre {
          background-color: var(--tw-prose-pre-bg);
          border-radius: 0.5rem;
          padding: 1em;
          overflow-x: auto;
          margin-top: 1.8em;
          margin-bottom: 1.8em;
        }

        .prose code {
          color: var(--tw-prose-code);
          font-weight: 600;
          font-size: 0.875em;
        }

        .prose pre code {
          background-color: transparent;
          border-width: 0;
          border-radius: 0;
          padding: 0;
          font-weight: 400;
          color: inherit;
          font-size: inherit;
          font-family: inherit;
          line-height: inherit;
        }
      </style>

      {data.body && data.body.map((slice: any) => {
        if (slice.slice_type === 'rich_text' && slice.items) {
          return slice.items.map((item: any) => {
            if (item.richtext) {
              return <div set:html={prismicH.asHTML(item.richtext, null, htmlSerializer)} />;
            }
            return null;
          });
        }
        return null;
      })}
    </div>

    <!-- Related Posts -->
    {relatedPosts.length > 0 && (
      <section class="mt-16 pt-8 border-t border-box-border">
        <div class="max-w-3xl mx-auto">
          <h2 class="text-2xl font-bold mb-8 text-heading-1">Схожі статті</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {relatedPosts.map((relatedPost) => {
              // Resolve image for related post
              let cardImg: { url: string; alt: string } | null = null;
              for (const slice of relatedPost.data?.body || []) {
                if (slice.slice_type === 'rich_text') {
                  for (const item of slice.items || []) {
                    for (const node of item.richtext || []) {
                      if (node.type === 'image' && node.url) {
                        cardImg = { url: node.url, alt: node.alt || (relatedPost.data.title?.[0]?.text || 'Blog post image') };
                        break;
                      }
                    }
                    if (cardImg) break;
                  }
                  if (cardImg) break;
                }
              }
              
              return (
                <article class="bg-box border border-box-border rounded-lg overflow-hidden shadow-sm hover:shadow-md transition-shadow duration-300" itemscope itemtype="https://schema.org/BlogPosting">
                  {cardImg && (
                    <div class="aspect-[16/9] overflow-hidden">
                      <img
                        src={`${cardImg.url}?auto=compress,format&w=400`}
                        alt={cardImg.alt}
                        class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                        loading="lazy"
                        width="400"
                        height="225"
                        itemprop="image"
                      />
                    </div>
                  )}
                  <div class="p-4">
                    <h3 class="text-lg font-semibold mb-2 text-heading-2">
                      <a href={`/blog/${relatedPost.uid}`} class="hover:text-primary transition-colors duration-300" itemprop="headline">
                        {relatedPost.data.title?.[0]?.text || 'No Title'}
                      </a>
                    </h3>
                    <p class="text-heading-3 text-sm mb-2">
                      <time datetime={relatedPost.first_publication_date} itemprop="datePublished">
                        {new Date(relatedPost.first_publication_date).toLocaleDateString('uk-UA', {
                          year: 'numeric',
                          month: 'short',
                          day: 'numeric'
                        })}
                      </time>
                    </p>
                    <p class="text-heading-3 text-sm line-clamp-2" itemprop="description">{relatedPost.data.text?.slice(0, 100)}...</p>
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      </section>
    )}
  </article>
</Layout> 