---
export interface Props{
    title:string,
    description:string
    icon: string
    href?: string
}

const {title, href} = Astro.props
---
<a href={href || "#"} class="group flex items-center justify-between gap-4 py-5 border-b border-box-border">
    <h3 class="text-lg sm:text-xl font-bold font-display text-heading-2 group-hover:text-primary transition-colors">
        {title}
    </h3>
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 shrink-0 text-heading-3 group-hover:text-primary group-hover:translate-x-1 transition-all">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
    </svg>
</a>
