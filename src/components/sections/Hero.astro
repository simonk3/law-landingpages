    ---
import ContactTelegram from "../shared/ContactTelegram.astro";
import Container from "../shared/Container.astro";
import Paragraph from "../shared/Paragraph.astro";
import BtnLink from "../shared/BtnLink.astro";

---

<section class="relative pt-32 lg:pt-40 pb-4">
    <Container className={"flex flex-col lg:flex-row gap-10 lg:gap-16 px-5 sm:px-6 md:px-8 lg:px-8"}>
        <div data-reveal-stagger="120" class="relative flex flex-col lg:py-7 xl:py-8 lg:max-w-none max-w-3xl mx-auto lg:mx-0 lg:flex-1 lg:w-7/12">
            <span class="text-xs sm:text-sm font-bold uppercase tracking-[0.25em] text-primary">Адвокатська компанія</span>

            <h1 class="mt-4 text-4xl/tight sm:text-5xl/tight md:text-6xl/tight
             font-bold text-heading-1">
             Адвокати <span class="text-primary">Кушніренко</span> в Києві
            </h1>
            <Paragraph className="mt-8 max-w-xl" data-reveal="up">
                Команда досвідчених адвокатів Lex Duo надає повний спектр юридичних послуг у Києві та по всій Україні: кримінальне, цивільне, військове та господарське право. Ми стоїмо на сторожі ваших інтересів.
            </Paragraph>

            <div data-reveal="up" class="mt-10 flex flex-col sm:flex-row gap-4">
                <BtnLink text="Отримати консультацію" href="#cta" variant="primary" />
                <BtnLink text="Наші послуги" href="/poslugy" variant="secondary" />
            </div>

            <div data-reveal="up" class="mt-10 w-full max-w-xl flex">
                <ContactTelegram />
            </div>
        </div>

        <div class="flex flex-1 lg:w-5/12 lg:h-auto relative lg:max-w-none lg:mx-0 mx-auto max-w-3xl">
            <div class="w-full aspect-[4/5] lg:aspect-auto lg:h-full relative">
                <picture>
                    <source
                        type="image/avif"
                        srcset="/images/hero-400.webp 400w, /images/hero-800.webp 800w"
                        sizes="(max-width: 768px) 400px, 800px"
                    >
                    <source
                        type="image/webp"
                        srcset="/images/hero-400.webp 400w, /images/hero-800.webp 800w"
                        sizes="(max-width: 768px) 400px, 800px"
                    >
                    <img
                        src="/images/hero-400.webp"
                        srcset="/images/hero-400.webp 400w, /images/hero-800.webp 800w"
                        sizes="(max-width: 768px) 400px, 800px"
                        alt="Адвокати Кушніренко - професійна юридична допомога"
                        width="800"
                        height="600"
                        decoding="async"
                        fetchpriority="high"
                        loading="eager"
                        class="w-full h-full object-cover"
                    >
                </picture>
                <div data-reveal="zoom" style="--reveal-delay:420ms" class="absolute -bottom-6 -left-6 bg-ink text-white px-6 py-5 hidden sm:block">
                    <span class="block text-3xl md:text-4xl font-display font-extrabold leading-none">30+</span>
                    <span class="block mt-1 text-xs uppercase tracking-wide text-white/70">років досвіду</span>
                </div>
            </div>
        </div>
    </Container>
</section>