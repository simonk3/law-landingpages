---
import Container from "../shared/Container.astro";

const stats = [
  { value: 30, suffix: "+", label: "Років досвіду" },
  { value: 95, suffix: "%", label: "Виграних справ у судах різних інстанцій" },
  { value: 90, suffix: "%", label: "Клієнтів повертаються для подальшої співпраці" },
  { value: 100, suffix: "%", label: "Конфіденційність гарантована" },
];
---

<section class="relative mt-12 md:mt-16">
  <Container>
    <div
      data-reveal-stagger="110"
      class="mx-auto lg:mx-0 px-6 sm:px-10 py-10 sm:py-14 bg-ink text-white md:divide-x divide-white/15 grid grid-cols-2 md:grid-cols-4 gap-y-8 gap-x-4 sm:gap-8 md:gap-6 lg:gap-12"
    >
      {stats.map((stat) => (
        <div data-reveal="up" class="text-center md:px-4">
          <p
            data-count-to={stat.value}
            data-count-suffix={stat.suffix}
            class="font-display font-extrabold text-3xl sm:text-4xl md:text-5xl text-primary tabular-nums"
          >
            {stat.value}{stat.suffix}
          </p>
          <p class="mt-2 text-white/70 text-sm sm:text-base">{stat.label}</p>
        </div>
      ))}
    </div>
  </Container>
</section>
