---
import Info from "../cards/Info.astro";
import Container from "../shared/Container.astro";
import Paragraph from "../shared/Paragraph.astro";
import Title from "../shared/Title.astro";

// SEO metadata for About Us section
const aboutUsSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Lex Duo",
  "alternateName": ["Адвокати Кушніренко", "Кушніренко", "Kushnirenko"],
  "description": "Адвокатська компанія з багаторічним досвідом у різних галузях права. Надаємо комплексні юридичні послуги від консультацій до судового захисту.",
  "url": "https://lexduo.com.ua",
  "logo": "https://lexduo.com.ua/images/hero-1200.webp",
  "image": "https://lexduo.com.ua/images/P9307467-600.webp",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Київ",
    "addressCountry": "UA",
    "addressRegion": "Київ"
  },
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "customer service",
    "availableLanguage": ["uk", "en", "ru"]
  },
  "founder": {
    "@type": "Person",
    "name": "Кушніренко Семен",
    "jobTitle": "Адвокат",
    "description": "Засновник адвокатської компанії Lex Duo"
  },
  "employee": [
    {
      "@type": "Person",
      "name": "Кушніренко Семен",
      "jobTitle": "Адвокат",
      "description": "Спеціалізація: кримінальне право, цивільне право, військове право"
    }
  ],
  "serviceType": [
    "Кримінальне право",
    "Цивільне право", 
    "Військове право",
    "Господарське право",
    "Сімейне право",
    "Трудове право",
    "Податкове право",
    "Адміністративне право",
    "Міжнародне право",
    "Корпоративне право",
    "Інтелектуальна власність",
    "Банківське право",
    "Медичне право",
    "Страхове право",
    "Земельне право",
    "Будівельне право",
    "Митне право",
    "Банкрутство",
    "Цифрове право",
    "Екологічне право",
    "Антимонопольне право"
  ],
  "areaServed": {
    "@type": "Country",
    "name": "Україна"
  },
  "availableLanguage": ["uk", "en", "ru"],
  "foundingDate": "2020",
  "mission": "Забезпечити клієнтам доступ до професійного, ефективного та людяного юридичного захисту — особливо у найскладніших ситуаціях, коли права потребують рішучого відстоювання.",
  "vision": "Бути надійним юридичним партнером для кожного, хто потребує захисту, та сприяти розвитку культури правової свідомості й справедливості в суспільстві."
};

---

<section id="about-us">
    <!-- About Us Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(aboutUsSchema, null, 2)}></script>
    
    <Container className="flex flex-col midmd:flex-row gap-10 lg:gap-12">
        <div class="max-w-md mx-auto midmd:max-w-none lg:mx-0 lg:pr-10 xl:pr-2 flex-1 flex w-11/12 midmd:w-5/12 lg:w-1/2 midmd:h-auto">
            <div class="w-full aspect-[3/4] relative">
                <div class="absolute rotate-45 -left-5 md:-left-10 lg:-left-20 xl:-left-24 p-1 top-1/2 w-16 h-16 bg-gradient-to-br from-primary to-orange-400 blur-3xl opacity-50"></div>
                <div class="absolute  p-1 -top-4 md:-top-10 right-0 w-20 h-20 bg-gradient-to-br from-primary to-orange-400 rounded-full blur-3xl opacity-60"></div>
                
                <span class="absolute w-full aspect-[16/5] -skew-x-12 rounded-full bg-gradient-to-tr from-primary to-green-400 opacity-40 blur-2xl left-0 bottom-0"></span>
                <picture>
                    <source
                        type="image/webp"
                        srcset="/images/P9307467-400.webp 400w, /images/P9307467-600.webp 600w, /images/P9307467-800.webp 800w"
                        sizes="(max-width: 640px) 90vw, (max-width: 1024px) 50vw, 33vw"
                    >
                    <img 
                        src="/images/P9307467-600.webp" 
                        alt="banner image" 
                        width="600" 
                        height="675"
                        loading="lazy"
                        class="w-full h-full object-cover absolute left-1/2 -translate-x-1/2 top-1/2 -translate-y-1/2" 
                    />
                </picture>
            </div>
        </div>
        <div class="flex-1 flex midmd:w-7/12 lg:w-1/2 flex-col">
            <Title>
                Ваші надійні партнери у правовому захисті

            </Title>
            <Paragraph className="mt-8">
                Адвокати з багаторічним досвідом у різних галузях права. Наші юристи надають комплексні юридичні послуги, від консультацій до судового захисту, зокрема в таких сферах, як корпоративне право, захист інтересів у суді, сімейне право та нерухомість. Ми працюємо на результат і робимо все можливе, щоб забезпечити максимальний захист ваших прав.
            </Paragraph>
            <div class="pt-8 grid grid-cols-2 items-center gap-4 max-w-3xl md:max-w-[none]">
                <Info description="Забезпечити клієнтам доступ до професійного, ефективного та людяного юридичного захисту — особливо у найскладніших ситуаціях, коли права потребують рішучого відстоювання.." title="Місія">
                    <span slot="icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="30" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 sm:w-5 sm:h-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
                        </svg>                              
                    </span>
                </Info>
                <Info description="Бути надійним юридичним партнером для кожного, хто потребує захисту, та сприяти розвитку культури правової свідомості й справедливості в суспільстві.." title="Бачення">
                    <span slot="icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="30" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 sm:w-5 sm:h-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                    </span>
                </Info>
            </div>
        </div>
    </Container>
</section>