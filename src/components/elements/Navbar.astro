---
import BtnLink from "../shared/BtnLink.astro";
import Container from "../shared/Container.astro";
import  Navitem from "../shared/Navitem.astro";
import Search from "../Search.astro";
import { contact } from "../../config/contact";

const navItems = [
    {
        href:"/",
        text:"Головна"
    },
    {
        href:"/poslugy/",
        text:"Послуги"
    },
    {
        href:"/blog/",
        text:"Блог"
    },
    {
        href:"/contact/",
        text:"Контакти"
    },
]
---

<header class="absolute inset-x-0 top-0 z-50 py-5 bg-body/95 backdrop-blur border-b border-box-border" style="overflow: visible;">
    <Container>
        <nav class="w-full flex justify-between gap-6 relative">
            <!-- logo -->
            <div class="min-w-max inline-flex relative">
                <a href="/" class="relative flex items-center gap-3">
                    <svg aria-hidden="true" focusable="false" width="36" height="36" viewBox="0 0 160 160" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-9 h-9">
                        <circle cx="80" cy="80" r="78" stroke="currentColor" stroke-width="4"/>
                        <circle cx="80" cy="80" r="70" fill="currentColor" fill-opacity="0.1"/>
                        <path d="M60 50h40v60H60z" stroke="currentColor" stroke-width="4" fill="none"/>
                        <path d="M70 50v60M90 50v60" stroke="currentColor" stroke-width="4"/>
                        <path d="M60 70h40M60 90h40" stroke="currentColor" stroke-width="4"/>
                    </svg>
                    <div class="inline-flex text-lg font-bold font-display uppercase tracking-tight text-heading-1">
                        Lex Duo
                    </div>
                </a>
            </div>

            <div data-nav-overlay aria-hidden="true" class="fixed hidden inset-0 lg:!hidden bg-box-bg bg-opacity-50 backdrop-filter backdrop-blur-xl" style="z-index: 40; pointer-events: auto;"></div>
            <div data-navbar id="primary-navigation" class="flex h-0 overflow-visible lg:!h-auto lg:scale-y-100 duration-300 ease-linear flex-col gap-y-6 gap-x-4 lg:flex-row w-full lg:justify-between lg:items-center absolute lg:relative top-full lg:top-0 bg-body lg:bg-transparent border-x border-x-box-border lg:border-x-0">
                <ul class="border-t border-box-border lg:border-t-0 px-6 lg:px-0 pt-6 lg:pt-0 flex flex-col lg:flex-row gap-y-4 gap-x-6 text-sm font-bold uppercase tracking-wide text-heading-2 w-full lg:justify-center lg:items-center">
                    {navItems.map(item=>{
                        return <Navitem {...item}/>
                    })
                    }
                </ul>

                <div class="lg:min-w-max flex flex-col lg:flex-row items-center gap-4 sm:w-max w-full pb-6 lg:pb-0 border-b border-box-bg lg:border-0 px-6 lg:px-0" style="overflow: visible;">
                    <Search className="w-full lg:w-auto" />
                    <a
                        href={contact.phoneHref}
                        data-gtm-element="navbar-phone"
                        class="hidden midmd:inline-flex items-center gap-2 text-sm font-bold text-heading-1 hover:text-primary transition-colors whitespace-nowrap"
                    >
                        <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-4 h-4">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                        </svg>
                        {contact.phoneDisplay}
                    </a>
                    <BtnLink text="Консультація" href="/contact/" className="flex justify-center w-full sm:w-max" variant="primary" data-contact-button/>
                </div>
            </div>


            <div class="min-w-max flex items-center gap-x-3">
                <button
                    data-switch-theme
                    type="button"
                    aria-label="Змінити тему оформлення"
                    aria-pressed="false"
                    class="outline-none flex relative text-heading-2 rounded-full p-2 lg:p-3 border border-box-border ">
                    <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 dark:flex hidden">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
                      </svg>
                      <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 dark:hidden">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
                      </svg>
                                    
                </button>
                
                <button
                    data-toggle-nav
                    data-open-nav="false"
                    type="button"
                    aria-label="Відкрити меню"
                    aria-expanded="false"
                    aria-controls="primary-navigation"
                    class="lg:hidden lg:invisible outline-none w-7 h-auto flex flex-col relative">
                    <span id="line1" aria-hidden="true" class="w-6 h-0.5 rounded-full bg-heading-2 transition-all duration-300 ease-linear"></span> 
                    <span id="line2" aria-hidden="true" class="w-6 origin-center  mt-1 h-0.5 rounded-ful bg-heading-2 transition-all duration-300 ease-linear"></span> 
                    <span id="line3" aria-hidden="true" class="w-6 mt-1 h-0.5 rounded-ful bg-heading-2 transition-all duration-300 ease-linear"></span>                         
                </button>
            </div>
        </nav>
    </Container>
</header>