---
import GroupFooterNav from "../blocks/GroupFooterNav.astro";
import Container from "../shared/Container.astro";
import FooterNav from "../shared/FooterNav.astro";
import { contact } from "../../config/contact";
import { practiceAreas } from "../../data/practice-areas";

// Driven off practice-areas.ts: the hardcoded list had drifted and was missing the
// ДТП page entirely, leaving it with a third of the internal links of its siblings.
const footerServices = practiceAreas.map((area) => ({
    itemText: area.navTitle,
    itemLink: `/poslugy/${area.slug}/`,
}));

const footerCompany = [
    {
        itemText: "Адвокати Кушніренко",
        itemLink: "/komanda/"
    },
    {
        itemText: "Послуги",
        itemLink: "/poslugy/"
    },
    {
        itemText: "Контакти",
        itemLink: "/contact/"
    },
    {
        itemText: "Блог",
        itemLink: "/blog/"
    }
]

---
<div class="mt-16"></div>
<footer class="relative bg-navy pt-20 text-white">
    <Container className="pb-8 relative overflow-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 relative">
            <div class="col-span-1 md:col-span-2 lg:col-span-1 h-auto flex flex-col">
                <div class="h-full">
                    <a href="/" class="relative flex items-center gap-3">
                        <svg aria-hidden="true" focusable="false" width="40" height="40" viewBox="0 0 160 160" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-10 h-10">
                            <circle cx="80" cy="80" r="78" stroke="currentColor" stroke-width="4"/>
                            <circle cx="80" cy="80" r="70" fill="currentColor" fill-opacity="0.1"/>
                            <path d="M60 50h40v60H60z" stroke="currentColor" stroke-width="4" fill="none"/>
                            <path d="M70 50v60M90 50v60" stroke="currentColor" stroke-width="4"/>
                            <path d="M60 70h40M60 90h40" stroke="currentColor" stroke-width="4"/>
                            <text x="80" y="115" text-anchor="middle" font-family="Georgia, serif" font-size="14" fill="currentColor" font-weight="500">Lex Duo</text>
                        </svg>
                        <div class="inline-flex text-lg font-bold font-display uppercase tracking-tight text-white">
                            Lex Duo
                        </div>
                    </a>
                    <p class="mt-8 md:text-lg text-white/70">
                        Адвокати Кушніренко. Професійна юридична допомога в Києві. Захищаємо ваші права та інтереси в суді та поза ним.
                    </p>
                </div>

                <!-- Contact Information -->
                <div class="mt-8 space-y-4">
                    <div class="flex items-center gap-3 text-white/70">
                        <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                        </svg>
                        <span>{contact.postalCode}, м. Київ, {contact.addressDistrict}, {contact.streetAddress}</span>
                    </div>
                    <a href={contact.phoneHref} data-gtm-element="footer-phone" class="flex items-center gap-3 text-white/70 hover:text-primary transition-colors">
                        <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                        </svg>
                        <span>{contact.phoneDisplay}</span>
                    </a>
                    <a href={contact.emailHref} class="flex items-center gap-3 text-white/70 hover:text-primary transition-colors">
                        <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                        </svg>
                        <span>{contact.email}</span>
                    </a>
                </div>

                <!-- Social: only profiles that exist. The Facebook/LinkedIn/Twitter
                     icons here pointed at href="#" — dead links on every page. -->
                <div class="min-h-max flex items-center gap-4 text-white/70 mt-8">
                    <a href={contact.telegram} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 transition hover:text-primary hover:scale-105">
                        <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="w-5 h-5" viewBox="0 0 16 16">
                            <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM8.287 5.906c-.778.324-2.334.994-4.666 2.01-.378.15-.577.298-.595.442-.03.243.275.339.69.47.057.018.116.037.177.057.414.135.97.292 1.26.298.262.006.555-.102.88-.325 2.2-1.484 3.335-2.234 3.407-2.25.05-.012.12-.026.166.016.047.041.042.12.037.141-.03.129-1.227 1.241-1.846 1.817-.193.18-.33.307-.358.336a8.154 8.154 0 0 1-.188.186c-.38.366-.664.64.015 1.088.327.216.589.393.85.571.284.194.568.387.936.629.093.06.183.125.27.187.331.236.63.448.997.414.214-.02.435-.22.547-.82.265-1.417.786-4.486.906-5.751a1.426 1.426 0 0 0-.013-.315.337.337 0 0 0-.114-.217.526.526 0 0 0-.31-.093c-.3.005-.763.166-2.984 1.09z"/>
                        </svg>
                        <span>Telegram</span>
                    </a>
                </div>
            </div>

            <div class="col-span-1 md:col-span-2 lg:col-span-3">
                <GroupFooterNav>
                    <FooterNav title={"Послуги"} navItems={footerServices}/>
                    <FooterNav title={"Компанія"} navItems={footerCompany}/>
                </GroupFooterNav>
            </div>

        </div>

        <div class="mt-16 pt-8 border-t border-white/10 text-center text-white/50">
            <p>&copy; {new Date().getFullYear()} Lex Duo — Адвокати Кушніренко. Всі права захищені.</p>
        </div>
    </Container>
</footer>
