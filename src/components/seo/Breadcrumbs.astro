---
export interface Props {
  items: { name: string; url: string }[];
}

const { items } = Astro.props;
const origin = Astro.url.origin;
---

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": items.map((item, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": item.name,
    "item": `${origin}${item.url}`
  }))
})}>
</script>

<nav aria-label="Breadcrumb" class="text-sm text-heading-3">
  <ol class="flex flex-wrap items-center gap-2">
    {items.map((item, index) => (
      <li class="flex items-center gap-2">
        {index > 0 && <span aria-hidden="true">/</span>}
        {index === items.length - 1 ? (
          <span aria-current="page" class="text-heading-2">{item.name}</span>
        ) : (
          <a href={item.url} class="hover:text-heading-1 transition-colors">{item.name}</a>
        )}
      </li>
    ))}
  </ol>
</nav>
