---
// Enhanced Legal Service Schema for better search visibility
export interface Props {
  serviceName: string;
  description: string;
  areaServed: string[];
  priceRange?: string;
  serviceType: string;
}

const { serviceName, description, areaServed, priceRange, serviceType } = Astro.props;
---

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LegalService",
  "name": serviceName,
  "description": description,
  "serviceType": serviceType,
  "priceRange": priceRange || "$$",
  // The organization is declared once, on the homepage, under this @id. Repeating
  // the full business record here produced a second, unanchored LegalService on
  // every service page, so Google had two competing entities for one firm — and
  // the copy here carried a stale address. A bare @id reference resolves to the
  // canonical entity instead.
  "provider": { "@id": "https://www.lexduo.com.ua/#organization" },
  "areaServed": areaServed.map(area => ({
    "@type": "City",
    "name": area
  })),
  "availableLanguage": ["uk"],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Юридичні послуги",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Кримінальне право",
          "description": "Захист у кримінальних справах, представництво в суді"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Військове право",
          "description": "Юридична допомога військовослужбовцям, мобілізація"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Цивільне право",
          "description": "Представництво в цивільних справах, договірне право"
        }
      }
    ]
  }
})}>
</script>
