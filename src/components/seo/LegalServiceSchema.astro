---
// One practice area as a schema.org Service offered by the firm.
// The firm itself (address, phone, hours) is declared once, on the homepage, under the
// #organization @id; this only points at it. Typing each practice page as its own
// LegalService made Google read nine separate businesses, none with an address.
export interface Props {
  serviceName: string;
  description: string;
  serviceType: string;
  /** Canonical path of the practice page, e.g. /poslugy/simeyne-pravo/ */
  path: string;
  /** The page's own service list, so the catalogue matches what the page offers. */
  serviceGroups: { audience: string; services: { title: string; items: string[] }[] }[];
}

const { serviceName, description, serviceType, path, serviceGroups } = Astro.props;
const site = Astro.site ?? new URL("https://www.lexduo.com.ua");
const url = new URL(path, site).href;
---

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${url}#service`,
  "name": serviceName,
  "description": description,
  "serviceType": serviceType,
  "url": url,
  "inLanguage": "uk-UA",
  "provider": { "@id": `${site.origin}/#organization` },
  "areaServed": [
    { "@type": "City", "name": "Київ" },
    { "@type": "Country", "name": "Україна" }
  ],
  "availableLanguage": ["uk"],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": serviceName,
    "itemListElement": serviceGroups.map((group) => ({
      "@type": "OfferCatalog",
      "name": group.audience,
      "itemListElement": group.services.map((service) => ({
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": service.title,
          "description": service.items.join("; ")
        }
      }))
    }))
  }
})}>
</script>
