---
export interface Props{
    title:string,
    navItems:{
        itemText:string,
        itemLink:string
    }[]
}

const {title, navItems} = Astro.props
---

<nav class="space-y-6 text-center sm:text-left">
    <h2 class="uppercase tracking-wide font-bold font-display text-white text-sm">
        {title}
    </h2>
    <ul class="space-y-3 font-medium md:text-lg text-white/70">
        {navItems.map((navItem)=>(
            <li>
                <a href={navItem.itemLink} class="transition hover:text-primary">
                    {navItem.itemText}
                </a>
            </li>
        ))
        }
    </ul>
</nav>