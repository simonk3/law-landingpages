---
export interface Props{
    href:string,
    text:string,
    className?:string,
    variant:"primary"|"secondary"
}

const {href, text,className, variant, ...rest} = Astro.props

const getThemeStyle = (variant:"primary"|"secondary")=>{
    if (variant === "primary") {
        return "bg-primary border-transparent relative after:bg-ink hover:border-ink"
    }
    return "text-heading-1 border-heading-1"
}

const getTextColor = (variant:"primary"|"secondary") =>{
    if (variant === "primary") {
        return "text-white"
    }
    return "text-heading-1"
}


---

<a href={href} class={`px-6 py-3 rounded-none outline-none relative overflow-hidden border duration-300 ease-linear uppercase text-sm font-bold tracking-wide font-display
                    after:absolute after:inset-x-0 after:aspect-square after:scale-0 after:opacity-100 after:origin-center after:duration-300 after:ease-linear after:top-0 after:left-0 after:bg-ink
                    ${getThemeStyle(variant)} hover:after:scale-[2.5] ${className}`} {...rest}>
    <span class={`relative ${getTextColor(variant)} z-10`}>
        {text}
    </span>
</a>