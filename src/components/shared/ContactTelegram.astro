---
interface Props {
  tgLink?: string;
  text?: string;
  className?: string;
}

const {
  tgLink = "https://t.me/kushnirenko33",
  text = "Написати в Telegram",
  className = "",
} = Astro.props;
---
<a
  href={tgLink}
  target="_blank"
  rel="noopener noreferrer"
  class={`inline-flex items-center gap-2 px-6 py-3 rounded-full outline-none relative overflow-hidden border duration-300 ease-linear bg-primary text-white border-transparent hover:border-[#172554] hover:bg-primary/90 focus:ring-2 focus:ring-primary/50 ${className}`}
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="currentColor"
    class="w-5 h-5"
    aria-hidden="true"
  >
    <path
      d="M21.5 3.5c0-.6-.5-1-1.1-.8L3.3 9.4c-.9.3-.9 1.6 0 1.9l5.1 1.7 1.9 5.5c.2.5.9.6 1.3.2l2.8-2.7 4.7 3.2c.5.3 1.1 0 1.2-.6l1.2-14.9zM9.8 12.7l7.9-5.3-6.2 6.9-.3 3.2-1.4-4.8z"
    />
  </svg>
  <span class="relative z-10">{text}</span>
</a>