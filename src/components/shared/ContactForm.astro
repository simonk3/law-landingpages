---
import LeadForm from "./LeadForm.astro";
---

<div
    id="contact-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="contact-modal-title"
    class="fixed inset-0 bg-black/60 hidden items-center justify-center z-[60] p-4 overflow-y-auto"
>
    <div class="bg-body border border-box-border rounded-2xl p-6 sm:p-8 max-w-md w-full relative my-auto">
        <button
            id="close-modal"
            type="button"
            aria-label="Закрити"
            class="absolute top-4 right-4 text-heading-3 hover:text-heading-1 transition-colors"
        >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>

        <h2 id="contact-modal-title" class="text-2xl font-bold text-heading-1 mb-2">Безкоштовна консультація</h2>
        <p class="text-heading-3 text-sm mb-6">Залиште контакти — адвокат зателефонує вам.</p>

        <LeadForm source="modal" />
    </div>
</div>

<script>
    const modal = document.getElementById("contact-modal");

    function openModal() {
        if (!modal) return;
        modal.classList.remove("hidden");
        modal.classList.add("flex");
        document.body.style.overflow = "hidden";
        modal.querySelector<HTMLInputElement>('input[name="name"]')?.focus();
    }

    function closeModal() {
        if (!modal) return;
        modal.classList.add("hidden");
        modal.classList.remove("flex");
        document.body.style.overflow = "";
    }

    // Delegated so it also catches buttons rendered after this script runs.
    document.addEventListener("click", (e) => {
        const trigger = (e.target as HTMLElement)?.closest?.("[data-contact-button]");
        if (!trigger) return;
        e.preventDefault();
        openModal();
    });

    document.getElementById("close-modal")?.addEventListener("click", closeModal);

    modal?.addEventListener("click", (e) => {
        if (e.target === modal) closeModal();
    });

    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && modal && !modal.classList.contains("hidden")) closeModal();
    });
</script>
