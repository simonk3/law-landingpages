---
export interface Props{
    className?:string,
    variant:"primary"|"secondary",
    "data-contact-button"?: boolean
}

const {className, variant, ...rest} = Astro.props

const getThemeStyle = (variant:"primary"|"secondary")=>{
    if (variant === "primary") {
        return "bg-primary text-white border-transparent relative after:bg-[#172554] hover:border-[#172554] focus:ring-2 focus:ring-primary/50"
    }
    return "text-primary bg-transparent border-primary hover:bg-primary/10 focus:ring-2 focus:ring-primary/30"
}

const dataAttributes = Object.entries(rest).map(([key, value]) => `${key}="${value}"`).join(' ');

---
<button class={`px-6 py-3 rounded-full outline-none relative overflow-hidden border duration-300 ease-linear
                    after:absolute after:inset-x-0 after:aspect-square after:scale-0 after:opacity-30 after:origin-center after:duration-300 after:ease-linear after:rounded-full after:top-0 after:left-0 after:bg-[#172554]
                    ${getThemeStyle(variant)} hover:after:opacity-40 hover:after:scale-[2.0] ${className}`} {...rest}>
    <span class="relative z-10"><slot/></span>
</button>