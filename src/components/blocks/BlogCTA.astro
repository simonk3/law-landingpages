---
import LeadForm from "../shared/LeadForm.astro";
import ContactTelegram from "../shared/ContactTelegram.astro";
import { contact } from "../../config/contact";

interface Props {
  /** Post slug, so lead attribution says which article produced the enquiry. */
  slug: string;
  /** Pulls the heading back to the article's subject instead of a generic pitch. */
  topic?: string;
}

const { slug, topic } = Astro.props;

const heading = topic
  ? `Маєте питання про ${topic}?`
  : "Маєте питання щодо вашої ситуації?";
---

<!--
  Sits at the foot of every post. The form is the same LeadForm the homepage CTA uses,
  so leads land in one place; `source` carries the slug, which is what makes per-article
  conversion readable in analytics rather than one undifferentiated "blog" bucket.
-->
<section
  aria-labelledby={`cta-${slug}`}
  class="mt-16 not-prose"
>
  <div class="relative overflow-hidden rounded-2xl bg-ink px-6 py-10 sm:px-10 sm:py-12">
    <span class="pointer-events-none absolute -right-10 -top-10 h-40 w-40 rounded-full bg-primary/20 blur-3xl"></span>
    <span class="pointer-events-none absolute -bottom-10 -left-10 h-40 w-40 rounded-full bg-cream/10 blur-3xl"></span>

    <div class="relative grid gap-10 lg:grid-cols-2 lg:gap-12">
      <div>
        <span class="block text-xs font-bold uppercase tracking-[0.25em] text-primary">
          Безкоштовна консультація
        </span>
        <h2 id={`cta-${slug}`} class="mt-4 text-2xl font-bold leading-tight text-white sm:text-3xl">
          {heading}
        </h2>
        <p class="mt-4 text-white/70">
          Стаття описує загальний порядок. Оцінити саме вашу ситуацію, перевірити
          документи та підказати наступний крок можна на безкоштовній консультації.
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a
            href={contact.phoneHref}
            data-gtm-element="blog-cta-phone"
            class="inline-flex items-center justify-center gap-2 rounded-full border border-white/25 px-6 py-3 text-white transition-colors hover:border-primary hover:text-primary"
          >
            <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
            </svg>
            {contact.phoneDisplay}
          </a>
          <ContactTelegram />
        </div>
      </div>

      <div class="rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm sm:p-8">
        <h3 class="mb-1 text-xl font-bold text-white">Отримати консультацію</h3>
        <p class="mb-6 text-sm text-white/60">Адвокат передзвонить вам сьогодні.</p>
        <LeadForm source={`blog:${slug}`} dark submitText="Отримати консультацію" />
      </div>
    </div>
  </div>
</section>
