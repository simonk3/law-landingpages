---
// SEO Analytics Component for Lex Duo
// This component handles all analytics and tracking for SEO optimization

interface Props {
  pageTitle?: string;
  pageDescription?: string;
  pageUrl?: string;
  pageType?: 'homepage' | 'service' | 'blog' | 'contact' | 'about';
  serviceCategory?: string;
  blogCategory?: string;
}

const {
  pageTitle = 'Lex Duo - Адвокати в Києві',
  pageDescription = 'Професійні юридичні послуги в Києві. Кримінальне право, цивільне право, військове право.',
  pageUrl = Astro.url.href,
  pageType = 'homepage',
  serviceCategory,
  blogCategory
} = Astro.props;

// Google Analytics 4 Configuration
const GA_MEASUREMENT_ID = 'G-XXXXXXXXXX'; // Replace with your actual GA4 ID
const GTM_ID = 'GTM-XXXXXXXX'; // Replace with your actual GTM ID

// Enhanced event tracking for legal services
const trackLegalServiceView = (serviceType: string) => {
  return `
    gtag('event', 'view_service', {
      'service_type': '${serviceType}',
      'page_title': '${pageTitle}',
      'page_url': '${pageUrl}',
      'custom_parameter_1': 'legal_service',
      'custom_parameter_2': 'ukraine'
    });
  `;
};

const trackContactFormSubmission = () => {
  return `
    gtag('event', 'form_submit', {
      'form_name': 'contact_form',
      'page_title': '${pageTitle}',
      'page_url': '${pageUrl}',
      'custom_parameter_1': 'legal_consultation',
      'custom_parameter_2': 'ukraine'
    });
  `;
};

const trackPhoneCall = () => {
  return `
    gtag('event', 'phone_call', {
      'phone_number': '+380-XX-XXX-XXXX',
      'page_title': '${pageTitle}',
      'page_url': '${pageUrl}',
      'custom_parameter_1': 'legal_consultation',
      'custom_parameter_2': 'ukraine'
    });
  `;
};

const trackTelegramContact = () => {
  return `
    gtag('event', 'social_contact', {
      'social_platform': 'telegram',
      'page_title': '${pageTitle}',
      'page_url': '${pageUrl}',
      'custom_parameter_1': 'legal_consultation',
      'custom_parameter_2': 'ukraine'
    });
  `;
};
---

<!-- Google Analytics 4 -->
<script type="text/partytown" async src="https://www.googletagmanager.com/gtag/js?id={GA_MEASUREMENT_ID}"></script>
<script type="text/partytown" define:vars={{ GA_MEASUREMENT_ID }}>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', GA_MEASUREMENT_ID, {
    'page_title': '{pageTitle}',
    'page_location': '{pageUrl}',
    'custom_map': {
      'custom_parameter_1': 'business_type',
      'custom_parameter_2': 'country'
    },
    'custom_parameter_1': 'legal_services',
    'custom_parameter_2': 'ukraine',
    'anonymize_ip': true,
    'allow_google_signals': false,
    'allow_ad_personalization_signals': false
  });
  
  // Enhanced E-commerce tracking for legal services
  gtag('event', 'page_view', {
    'page_title': '{pageTitle}',
    'page_location': '{pageUrl}',
    'page_type': '{pageType}',
    'service_category': '{serviceCategory || ""}',
    'blog_category': '{blogCategory || ""}',
    'custom_parameter_1': 'legal_services',
    'custom_parameter_2': 'ukraine'
  });
</script>

<!-- Google Tag Manager -->
<script type="text/partytown" define:vars={{ GTM_ID }}>
  (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer', GTM_ID);
</script>

<!-- Google Tag Manager (noscript) -->
<noscript>
  <iframe src="https://www.googletagmanager.com/ns.html?id={GTM_ID}" height="0" width="0" style="display:none;visibility:hidden"></iframe>
</noscript>

<!-- Enhanced Event Tracking Scripts -->
<script type="text/partytown" define:vars={{ pageTitle, pageUrl, trackLegalServiceView, trackContactFormSubmission, trackPhoneCall, trackTelegramContact }}>
  // Legal service view tracking
  function trackServiceView(serviceType) {
    {trackLegalServiceView(serviceType)}
  }
  
  // Contact form submission tracking
  function trackContactSubmit() {
    {trackContactFormSubmission()}
  }
  
  // Phone call tracking
  function trackCall() {
    {trackPhoneCall()}
  }
  
  // Telegram contact tracking
  function trackTelegram() {
    {trackTelegramContact()}
  }
  
  // Blog engagement tracking
  function trackBlogEngagement(action, blogTitle) {
    gtag('event', 'blog_engagement', {
      'action': action,
      'blog_title': blogTitle,
      'page_title': '{pageTitle}',
      'page_url': '{pageUrl}',
      'custom_parameter_1': 'legal_blog',
      'custom_parameter_2': 'ukraine'
    });
  }
  
  // Service consultation tracking
  function trackConsultationRequest(serviceType) {
    gtag('event', 'consultation_request', {
      'service_type': serviceType,
      'page_title': '{pageTitle}',
      'page_url': '{pageUrl}',
      'custom_parameter_1': 'legal_consultation',
      'custom_parameter_2': 'ukraine'
    });
  }
  
  // Make functions globally available
  window.trackServiceView = trackServiceView;
  window.trackContactSubmit = trackContactSubmit;
  window.trackCall = trackCall;
  window.trackTelegram = trackTelegram;
  window.trackBlogEngagement = trackBlogEngagement;
  window.trackConsultationRequest = trackConsultationRequest;
</script>

