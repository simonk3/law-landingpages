---
interface Props {
  tgLink?: string;
  ariaLabel?: string;
}

const { tgLink = "https://t.me/kushnirenko33", ariaLabel = "Відкрити Telegram" } = Astro.props;
---
<a href={tgLink} target="_blank" rel="noopener noreferrer" aria-label={ariaLabel}
   class="fixed bottom-6 right-6 z-50">
  <span class="sr-only">{ariaLabel}</span>
  <div class="w-14 h-14 rounded-full shadow-lg shadow-black/20 ring-1 ring-black/10 flex items-center justify-center bg-sky-500 hover:bg-sky-600 text-white transition-colors animate-bounce">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-7 h-7" fill="currentColor" aria-hidden="true">
      <path d="M21.5 3.5c0-.6-.5-1-1.1-.8L3.3 9.4c-.9.3-.9 1.6 0 1.9l5.1 1.7 1.9 5.5c.2.5.9.6 1.3.2l2.8-2.7 4.7 3.2c.5.3 1.1 0 1.2-.6l1.2-14.9zM9.8 12.7l7.9-5.3-6.2 6.9-.3 3.2-1.4-4.8z"/>
    </svg>
  </div>
</a>
<style>
  @media (prefers-reduced-motion: reduce) {
    .animate-bounce {
      animation: none !important;
    }
  }
</style>