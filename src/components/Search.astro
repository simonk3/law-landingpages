---
// Algolia Search Component for Lex Duo
// This component provides site-wide search functionality
import SearchBox from './SearchBox.tsx';

interface Props {
  className?: string;
}

const { className = "" } = Astro.props;

// These will be set as environment variables
const ALGOLIA_APP_ID = import.meta.env.PUBLIC_ALGOLIA_APP_ID;
const ALGOLIA_SEARCH_KEY = import.meta.env.PUBLIC_ALGOLIA_SEARCH_KEY;
const ALGOLIA_INDEX_NAME = import.meta.env.PUBLIC_ALGOLIA_INDEX_NAME;

// #region agent log
console.log(JSON.stringify({location:'Search.astro:15',message:'Environment variables check',data:{hasAppId:!!ALGOLIA_APP_ID,hasSearchKey:!!ALGOLIA_SEARCH_KEY,hasIndexName:!!ALGOLIA_INDEX_NAME,appIdValue:ALGOLIA_APP_ID?.substring(0,5)+'...'},timestamp:Date.now(),sessionId:'debug-session',hypothesisId:'B'}));
// #endregion

// Only render if we have the required config
const hasAlgoliaConfig = ALGOLIA_APP_ID && ALGOLIA_SEARCH_KEY && ALGOLIA_INDEX_NAME;
---

{hasAlgoliaConfig ? (
  <div class={`search-container ${className}`}>
    <!-- #region agent log -->
    <script>console.log(JSON.stringify({location:'Search.astro:25',message:'About to render SearchBox',data:{hasConfig:true,clientDirective:'client:load'},timestamp:Date.now(),sessionId:'debug-session',hypothesisId:'D,E'}));</script>
    <!-- #endregion -->
    <SearchBox 
      appId={ALGOLIA_APP_ID}
      searchKey={ALGOLIA_SEARCH_KEY}
      indexName={ALGOLIA_INDEX_NAME}
      client:load
    />
  </div>
) : (
  <div class={`search-placeholder ${className}`}>
    <div class="relative w-full max-w-md">
      <input
        type="text"
        placeholder="Пошук по сайту..."
        disabled
        class="w-full px-4 py-2 pl-10 pr-4 text-gray-400 bg-gray-100 border border-gray-200 rounded-lg cursor-not-allowed"
      />
      <div class="absolute inset-y-0 left-0 flex items-center pl-3">
        <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
    </div>
  </div>
)}


<style>
  .search-container {
    position: relative;
    z-index: 1000;
  }
  
  .search-placeholder {
    opacity: 0.7;
  }
  
  /* Custom styles for search results */
  :global(.line-clamp-2) {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  /* Ensure search dropdown appears above other elements */
  :global(.search-container .absolute) {
    z-index: 9999;
  }
</style>
